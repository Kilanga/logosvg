# Copier en `.env` (ignoré par git) et remplir. Jamais de vraie valeur ici.
#
#   cp .env.example .env
#
# `bin/dev` charge ce fichier avant de démarrer les processus : Rails et le
# microservice de génération reçoivent donc la même clé partagée, sans
# duplication. En production, ces valeurs viennent de l'environnement ou des
# credentials Rails chiffrés — jamais d'un fichier du dépôt.

# --- Microservice de génération ---------------------------------------------
# Adresse du service FastAPI de services/generator/.
GENERATOR_URL=http://127.0.0.1:5000
# Clé partagée, envoyée dans l'en-tête X-API-Key. Le microservice lit la même
# valeur sous le nom API_KEY (voir plus bas).
#   openssl rand -base64 32
GENERATOR_API_KEY=
# Clé HMAC servant à pseudonymiser l'identifiant utilisateur transmis au
# service (RGPD). Distincte de la précédente.
#   openssl rand -hex 32
GENERATOR_USER_KEY=

# Le microservice lit sa propre clé sous ce nom : mettre la même valeur que
# GENERATOR_API_KEY. python-dotenv ne remplace pas les variables déjà
# présentes dans l'environnement, donc celle-ci fait autorité.
API_KEY=
# mock : dessin de substitution, sans GPU. comfyui : vraie génération.
GENERATOR_MODE=mock

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants des deux prix d'abonnement imprimeur.
STRIPE_PRICE_LISTING=
STRIPE_PRICE_ATELIER_PLUS=

# --- Cloudflare Turnstile (anti-robot) --------------------------------------
# Sans ces clés, la vérification est désactivée en développement.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Base de données ---------------------------------------------------------
# Laisser vide pour utiliser la socket locale PostgreSQL avec le rôle du
# système, ce que fait config/database.yml par défaut en développement.
# DATABASE_URL=
