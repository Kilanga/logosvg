#!/usr/bin/env sh

# Runs the already delivered FastAPI generator service from services/generator
# in mock mode, as one of the bin/dev processes. The service itself is never
# modified here: this script only creates its virtualenv on first run and
# starts uvicorn with the environment loaded by bin/dev.

set -e
cd "$(dirname "$0")/../services/generator/microservice"

if [ -z "$API_KEY" ]; then
  echo "generator: API_KEY is empty. Copy .env.example to .env at the repository"
  echo "generator: root and set API_KEY (same value as GENERATOR_API_KEY)."
  exit 1
fi

# vtracer 0.6.15 publishes a cp314 wheel that imports but segfaults on the first
# conversion, so the virtualenv is built on the newest interpreter known to work.
# This only concerns local mock mode: the real service runs on the generation
# machine with its own environment.
PYTHON=""
for candidate in python3.13 python3.12 python3; do
  command -v "$candidate" >/dev/null 2>&1 && { PYTHON="$candidate"; break; }
done
if [ -z "$PYTHON" ]; then
  echo "generator: no python3 interpreter found."
  exit 1
fi

if [ ! -x .venv/bin/python ]; then
  echo "generator: creating the virtualenv with $PYTHON (first run only)..."
  "$PYTHON" -m venv .venv
  .venv/bin/pip install --quiet --upgrade pip
  .venv/bin/pip install --quiet -r requirements.txt
fi

# mock replaces image generation with a simple drawing; vectorisation, the
# queue, the prompt filter and the rate limiter all still run for real.
export GENERATOR_MODE="${GENERATOR_MODE:-mock}"

exec .venv/bin/python -m uvicorn app.main:app \
  --host 127.0.0.1 \
  --port "${GENERATOR_PORT:-5000}"
