# Ce fichier est versionné : il ne contient aucune valeur, seulement d'où
# chaque secret est lu. Les valeurs vivent dans l'environnement de la machine
# qui déploie, jamais ici.
#
# Avant un déploiement, les poser une fois dans le terminal (ou dans un
# gestionnaire de mots de passe, puis les exporter) :
#
#   export SECRET_KEY_BASE=...           # 128 caractères, `openssl rand -hex 64`
#   export KAMAL_REGISTRY_PASSWORD=...   # jeton GitHub, portée write:packages
#   export TSHIRT_IA_DATABASE_PASSWORD=... # le même que POSTGRES_PASSWORD
#   export POSTGRES_PASSWORD="$TSHIRT_IA_DATABASE_PASSWORD"
#   export GENERATOR_API_KEY=...         # C:\tshirt-ia\CLE-API.txt
#   export GENERATOR_USER_KEY=...        # clé HMAC de pseudonymisation
#   export SMTP_USER_NAME=... SMTP_PASSWORD=...   # Brevo
#
#   export STRIPE_SECRET_KEY=... STRIPE_PUBLISHABLE_KEY=... STRIPE_WEBHOOK_SECRET=...
#   export STRIPE_PRICE_LISTING=... STRIPE_PRICE_ATELIER_PLUS=... STRIPE_TAX_RATE=...
#   export STRIPE_CONNECT_WEBHOOK_SECRET=...   # facultatif, paiements graphistes
#   export TURNSTILE_SITE_KEY=... TURNSTILE_SECRET_KEY=...
#
# Kamal refuse de déployer si un nom déclaré dans config/deploy.yml manque de
# ce fichier. Une valeur vide, elle, passe : l'application démarre et signale
# dans /admin ce qui n'est pas configuré.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# La clé qui signe les cookies et les jetons. Elle vient de l'environnement,
# et non de `config/master.key` : ce dépôt n'a jamais eu de clé maîtresse, si
# bien que `config/credentials.yml.enc` est indéchiffrable par quiconque. Lire
# un fichier absent donnait une valeur vide, et l'application refusait de
# démarrer en production — en parlant de credentials, jamais de la vraie cause.
#
# Elle ne doit plus jamais changer : la modifier invalide d'un coup toutes les
# sessions et tous les jetons signés en circulation.
SECRET_KEY_BASE=$SECRET_KEY_BASE

TSHIRT_IA_DATABASE_PASSWORD=$TSHIRT_IA_DATABASE_PASSWORD
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

GENERATOR_API_KEY=$GENERATOR_API_KEY
GENERATOR_USER_KEY=$GENERATOR_USER_KEY

SMTP_USER_NAME=$SMTP_USER_NAME
SMTP_PASSWORD=$SMTP_PASSWORD

# Paiements (Stripe) : clés, prix HT des deux formules, taux de TVA.
STRIPE_SECRET_KEY=$STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=$STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_LISTING=$STRIPE_PRICE_LISTING
STRIPE_PRICE_ATELIER_PLUS=$STRIPE_PRICE_ATELIER_PLUS
STRIPE_TAX_RATE=$STRIPE_TAX_RATE
# Le second endpoint, celui des comptes connectés des graphistes. Facultatif :
# vide, il ne bloque pas le déploiement.
STRIPE_CONNECT_WEBHOOK_SECRET=$STRIPE_CONNECT_WEBHOOK_SECRET

# Anti-robot (Cloudflare Turnstile).
TURNSTILE_SITE_KEY=$TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=$TURNSTILE_SECRET_KEY
