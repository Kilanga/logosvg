# --- Sécurité ---------------------------------------------------------------
# Clé partagée avec l'application Rails, qui l'envoie dans l'en-tête X-API-Key
# (GENERATOR_API_KEY côté Rails). Générer une valeur longue et aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-moi

# --- Génération -------------------------------------------------------------
# mock    : fausse image générée localement (tests sans GPU)
# comfyui : vraie génération via ComfyUI (machine d'hébergement)
GENERATOR_MODE=mock
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=180
IMAGE_SIZE=1024

# --- Modele d'image -----------------------------------------------------------
# FLUX.2 [klein] 4B distille (Apache 2.0, usage commercial permis). Trois
# fichiers dans ComfyUI\models : diffusion_models, text_encoders et vae
# (INSTALLER-MODELES.bat). Distille : 4 pas, CFG 1, pas de prompt negatif.
FLUX_UNET=flux-2-klein-4b-fp8.safetensors
FLUX_TEXT_ENCODER=qwen_3_4b.safetensors
FLUX_VAE=flux2-vae.safetensors
FLUX_STEPS=4
FLUX_CFG=1.0
# Propositions dessinees a chaque demande ; le client en choisit une.
PROPOSALS=3

# --- Traduction FR -> EN du prompt (optionnel, via Ollama) ------------------
# Laisser OLLAMA_URL vide pour désactiver. Exemple : http://127.0.0.1:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b

# --- Anti-abus --------------------------------------------------------------
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW_SECONDS=3600
MAX_QUEUE=10
BLOCKLIST_FILE=blocklist.txt

# --- Stockage ---------------------------------------------------------------
DATA_DIR=data
JOB_TTL_SECONDS=3600
MAX_PATHS_WARNING=400

# --- Retouches et variantes -------------------------------------------------
# Nombre de reprises (variantes + retouches) autorisees par design, avant de
# proposer au client de passer la main a un graphiste.
MAX_REFINEMENTS=3
# Ecart de la retouche par rapport a l'image de depart : 0.4 = retouche fine,
# 0.7 = grosse reinterpretation. 0.55 conserve la composition.
REFINE_DENOISE=0.55
# Image de depart fournie par le client (croquis, logo, photo) : ecart du dessin
# par rapport a elle. Plus haut qu'une retouche, pour changer de style.
UPLOAD_DENOISE=0.7

# --- Definition du fichier matriciel (DTF, DTG, sublimation) -----------------
# Seconde passe de diffusion qui redessine l'image plus grande, au lieu de
# l'interpoler : sans elle, a 25 cm de large le dessin ne vaut que 104 dpi reels
# et l'atelier voit une alerte "definition faible" a chaque commande.
#   1.0 = desactivee   1.5 = 156 dpi a 25 cm (defaut, sur pour 12 Go de VRAM)
#   2.0 = 208 dpi, plus gourmand en memoire
HIRES_SCALE=1.5
# Ce que la seconde passe a le droit de reinventer. Au-dela de 0.5, le dessin change.
HIRES_DENOISE=0.35

# Agrandissement par modele apres la passe haute definition, pour que le DTF
# atteigne vraiment 300 dpi a la taille d'impression. Nom d'un fichier place
# dans ComfyUI\models\upscale_models ; vide = desactive. Conseille :
# RealESRGAN_x4plus_anime_6B.pth (licence BSD, adapte aux aplats et aux
# illustrations). Eviter 4x-UltraSharp : licence non commerciale.
UPSCALE_MODEL=
