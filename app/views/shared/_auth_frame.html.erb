<%# Frame shared by the sign-in, sign-up and password screens.

    The form sits on white; beside it, a panel carrying the silkscreen mesh and
    a row of registration marks — the workshop's own vocabulary rather than a
    decorative illustration. The panel is hidden on small screens, where it
    would only push the form below the fold.

    Note for callers: the block you pass is evaluated in *this* partial's
    context, so a lazy `t(".key")` inside it resolves to
    shared.auth_frame.key. Use absolute keys in the block. %>
<div class="mx-auto w-full max-w-5xl px-5 py-12 lg:py-20">
  <div class="panel grid overflow-hidden lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]">
    <div class="p-6 lg:p-10">
      <p class="label-rule text-emulsion"><%= eyebrow %></p>
      <h1 class="mt-3 text-3xl font-bold uppercase leading-[0.95] lg:text-4xl"><%= title %></h1>

      <% if local_assigns[:subtitle].present? %>
        <p class="mt-4 max-w-sm text-muted"><%= subtitle %></p>
      <% end %>

      <div class="mt-8"><%= yield %></div>
    </div>

    <aside class="screen-tint hidden flex-col justify-between border-s border-line p-10 lg:flex" aria-hidden="true">
      <div class="flex gap-6 text-emulsion">
        <%= registration_mark %>
        <%= registration_mark %>
        <%= registration_mark %>
      </div>

      <p class="font-display text-2xl font-bold uppercase leading-[1.05] text-ink">
        <%= t("platform.tagline") %>
      </p>
    </aside>
  </div>
</div>
