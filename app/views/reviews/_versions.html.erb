<%# The versions handed back, newest last, numbered as both sides call them.
    Shared by the client's screen and the designer's. %>
<% if versions.any? %>
  <ol class="space-y-3">
    <% versions.each do |version| %>
      <li class="panel overflow-hidden">
        <div class="flex flex-wrap items-baseline justify-between gap-3 border-b border-line px-4 py-3">
          <p class="label-rule text-emulsion">
            <%= t("reviews.version", number: version.number) %>
          </p>
          <time class="text-sm text-muted" datetime="<%= version.created_at.iso8601 %>">
            <%= l(version.created_at, format: :short) %>
          </time>
        </div>

        <%# What was delivered, seen before anyone answers it (reported on
            15/10/2026, blocking: only the message and the size were shown). %>
        <div class="screen-tint border-b border-line p-4">
          <%= image_tag review_version_image_path(version.review, number: version.number),
                alt: t("reviews.version_preview", number: version.number), loading: "lazy",
                class: "mx-auto max-h-96 w-auto max-w-full object-contain" %>
        </div>
        <% if local_assigns[:downloads] %>
          <p class="border-b border-line px-4 py-3 text-sm">
            <%= link_to t("reviews.download_version", file_format: version.file.filename.extension.upcase),
                  designer_review_version_file_path(version.review, number: version.number),
                  class: "underline underline-offset-4 hover:text-emulsion" %>
          </p>
        <% else %>
          <p class="border-b border-line px-4 py-2 text-xs text-muted"><%= t("reviews.version_preview_hint") %></p>
        <% end %>

        <% if version.message.present? %>
          <p class="border-b border-line px-4 py-3 whitespace-pre-line"><%= version.message %></p>
        <% end %>

        <%# The designer's own account of the brief, point by point (decided
            on 08/10/2026): what the client and, in a dispute, an
            administrator check the delivery against. %>
        <% if version.brief_coverage.present? %>
          <ul class="flex flex-wrap gap-x-5 gap-y-1 border-b border-line px-4 py-3 text-sm"
              aria-label="<%= t("reviews.brief.coverage") %>">
            <% version.brief_coverage.each do |key, covered| %>
              <li class="flex items-center gap-1.5 <%= covered ? "text-success" : "text-warning" %>">
                <span aria-hidden="true" class="font-bold"><%= covered ? "✓" : "–" %></span>
                <%= t("reviews.brief.#{key}") %>
                <span class="sr-only"><%= covered ? t("reviews.brief.covered") : t("reviews.brief.not_covered") %></span>
              </li>
            <% end %>
          </ul>
        <% end %>

        <dl class="flex flex-wrap gap-x-6 gap-y-1 px-4 py-3 text-sm">
          <% version_checks(version).each do |check| %>
            <dd class="text-muted"><%= check %></dd>
          <% end %>
        </dl>

        <% if version_warnings(version).any? %>
          <ul class="border-t border-line">
            <% version_warnings(version).each do |warning| %>
              <li class="flex gap-3 border-l-2 border-warning bg-warning-bg px-4 py-2 text-sm text-warning">
                <%= registration_mark css_class: "mt-0.5 flex-none" %><%= warning %>
              </li>
            <% end %>
          </ul>
        <% end %>
      </li>
    <% end %>
  </ol>
<% else %>
  <div class="panel p-6 text-center">
    <p class="text-muted"><%= t("reviews.no_version") %></p>
  </div>
<% end %>
