<%# Shown on every page to an account whose address is not verified yet: what
    is waiting, where the email went, and how to get another. %>
<% if Current.user && !Current.user.email_verified? %>
  <div class="border-b border-warning/30 bg-warning-bg text-warning" role="status">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-4 gap-y-2 px-5 py-3 text-sm">
      <%= registration_mark css_class: "flex-none" %>
      <p class="min-w-0 flex-1">
        <%= t("email_verifications.banner.body_html", email: Current.user.email_address) %>
      </p>
      <%= button_to t("email_verifications.banner.resend"), email_verifications_path,
            class: "font-semibold underline underline-offset-4 hover:no-underline" %>
    </div>
  </div>
<% end %>
