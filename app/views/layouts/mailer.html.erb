<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= t("platform.name", default: Rails.application.config.tshirt.platform_name) %></title>
  </head>

  <%# Every style is inline: email clients strip stylesheets, and half of them
      strip <style> blocks too. The colours are the application's own tokens,
      written out because there is no stylesheet to read them from. %>
  <body style="margin:0;padding:0;background:#F2F4F3;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"
           style="width:100%;background:#F2F4F3;">
      <tr>
        <td align="center" style="padding:24px 12px;">
          <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                 style="width:100%;max-width:600px;background:#FFFFFF;border:1px solid #C8D0D4;">
            <%# The emulsion rule across the top, as on every page of the site. %>
            <tr><td style="height:4px;background:#1F5F7A;line-height:4px;font-size:0;">&nbsp;</td></tr>

            <tr>
              <td style="padding:24px 28px 0;">
                <p style="margin:0;font-family:Helvetica,Arial,sans-serif;font-size:13px;
                          letter-spacing:0.06em;text-transform:uppercase;font-weight:700;color:#1D2433;">
                  <%= Rails.application.config.tshirt.platform_name %>
                </p>
              </td>
            </tr>

            <tr><td style="padding:20px 28px 28px;"><%= yield %></td></tr>

            <tr>
              <td style="padding:16px 28px 24px;border-top:1px solid #C8D0D4;">
                <p style="margin:0;font-family:Helvetica,Arial,sans-serif;font-size:12px;
                          line-height:1.5;color:#505A67;">
                  <%= t("mailers.footer.sent_by", name: Rails.application.config.tshirt.platform_name) %>
                </p>
                <p style="margin:8px 0 0;font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#505A67;">
                  <a href="<%= privacy_url %>" style="color:#505A67;"><%= t("legal.privacy.title") %></a>
                  &nbsp;·&nbsp;
                  <a href="<%= terms_url %>" style="color:#505A67;"><%= t("legal.terms.title") %></a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
