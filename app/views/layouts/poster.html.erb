<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= yield(:title) %></title>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%# The print rules — one A4 page, edge to edge, backgrounds kept — live in
        the stylesheet with `.poster`: the CSP gives no nonce to <style>, so a
        block written here would be dropped without a word. %>
  </head>

  <body class="bg-paper text-ink antialiased print:bg-white">
    <div class="border-b border-line bg-surface px-5 py-3 print:hidden">
      <div class="mx-auto flex max-w-[210mm] flex-wrap items-center justify-between gap-3">
        <div class="text-sm text-muted">
          <p><%= t("workshop.links.poster.print_hint") %></p>
          <% if content_for?(:hint) %><p class="mt-1"><%= yield(:hint) %></p><% end %>
        </div>
        <div class="flex gap-3">
          <%= link_to t("workshop.links.poster.back"), workshop_link_share_path,
                class: "btn btn-secondary text-sm" %>
          <button type="button" class="btn btn-primary text-sm"
                  data-controller="print" data-action="print#now">
            <%= t("workshop.links.poster.print") %>
          </button>
        </div>
      </div>
    </div>

    <%# The poster is A4 at its real size: a narrow screen scrolls across it
        rather than squeezing it. %>
    <main class="overflow-x-auto px-5 py-8 print:overflow-visible print:p-0">
      <%= yield %>
    </main>
  </body>
</html>
