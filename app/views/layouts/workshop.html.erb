<%# Workshop space. %>
<% content_for :space_name, t("nav.workshop") %>
<% content_for :space_nav do %>
  <%= render "layouts/space_link",
        label: t("nav.dashboard"),
        path: workshop_dashboard_path,
        current: current_page?(workshop_dashboard_path) %>
  <%= render "layouts/space_link",
        label: t("nav.print_requests"),
        path: workshop_print_requests_path,
        current: current_page?(workshop_print_requests_path) %>
  <%= render "layouts/space_link",
        label: t("nav.reviews"),
        path: workshop_reviews_path,
        current: current_page?(workshop_reviews_path) %>
  <%= render "layouts/space_link",
        label: t("nav.my_clients"),
        path: workshop_clients_path,
        current: current_page?(workshop_clients_path) %>
  <%= render "layouts/space_link",
        label: t("nav.client_sheets"),
        path: workshop_invites_path,
        current: current_page?(workshop_invites_path) %>
  <%= render "layouts/space_link",
        label: t("nav.my_listing"),
        path: edit_workshop_profile_path,
        current: current_page?(edit_workshop_profile_path) %>
  <%= render "layouts/space_link",
        label: t("nav.my_link"),
        path: workshop_link_share_path,
        current: current_page?(workshop_link_share_path) %>
  <%= render "layouts/space_link",
        label: t("nav.subscription"),
        path: workshop_subscription_path,
        current: current_page?(workshop_subscription_path) %>
  <%= render "layouts/space_link",
        label: t("nav.help"),
        path: workshop_help_path,
        current: current_page?(workshop_help_path) %>
<% end %>
<%= render template: "layouts/console" %>
