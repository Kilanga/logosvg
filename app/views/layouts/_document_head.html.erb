<%# Head shared by every layout: public pages and professional consoles. %>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title><%= page_title %></title>
<meta name="description" content="<%= yield(:description).presence || t("platform.tagline") %>">
<meta name="application-name" content="<%= platform_name %>">
<meta name="theme-color" content="#1D2433">

<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%# Self-hosted faces: preloaded so headings do not reflow on first paint. %>
<link rel="preload" href="<%= asset_path("Figtree.woff2") %>" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="<%= asset_path("BarlowCondensed-700.woff2") %>" as="font" type="font/woff2" crossorigin>

<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="icon" href="/icon.png" type="image/png">
<link rel="apple-touch-icon" href="/icon.png">

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>

<%= yield :head %>
