<%= t("mailers.workshop_link.invite.greeting") %>
<%= t("mailers.workshop_link.invite.intro") %>
<% if @printer.link_email_note.present? %>

<%= @printer.link_email_note %>
<% end %>

<%= t("mailers.workshop_link.invite.cta") %> : <%= @url %>

<%= t("mailers.workshop_link.invite.returning_title") %> <%= t("mailers.workshop_link.invite.returning_body") %>

<% t("mailers.workshop_link.invite.steps").each_with_index do |step, index| %>
<%= index + 1 %>. <%= step[:title] %> <%= I18n.interpolate(step[:body], @figures) %>
<% end %>
<% t("mailers.workshop_link.invite.notes").each do |note| %>
<%= note[:title] %> <%= note[:body] %>
<% end %>
