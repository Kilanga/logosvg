<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading") %>

<div class="max-w-4xl space-y-10">
  <%# The counts are the point: an administrator opens this to find out whether
      anything needs them, not to read figures. %>
  <section>
    <h2 class="label-rule border-b border-line pb-3 text-emulsion"><%= t(".waiting_on_you") %></h2>

    <dl class="mt-4 grid gap-4 sm:grid-cols-3">
      <%= render "tile", count: @waiting[:printers], label: t(".printers"),
            path: admin_printers_path %>
      <%= render "tile", count: @waiting[:designers], label: t(".designers"),
            path: admin_designers_path %>
      <%= render "tile", count: @waiting[:disputes], label: t(".disputes"),
            path: admin_reviews_path(filtre: "disputed") %>
    </dl>

    <% if @waiting.values.sum.zero? %>
      <p class="mt-4 flex items-center gap-3 text-muted">
        <span class="text-success" aria-hidden="true"><%= registration_mark %></span>
        <%= t(".nothing_waiting") %>
      </p>
    <% end %>
  </section>

  <%# The Brevo plan's 300 emails a day, for the whole site (decided on
      10/10/2026). Near the limit, the next emails wait for tomorrow; one that
      could not leave at all is counted here. %>
  <section aria-labelledby="emails-title">
    <h2 id="emails-title" class="label-rule border-b border-line pb-3"><%= t(".emails") %></h2>
    <div class="panel mt-4 flex flex-wrap items-center gap-4 p-4 <%= 'border-l-2 border-l-warning' if @mail_today.near_limit? || @mail_failed.positive? %>">
      <p class="font-display text-4xl font-bold <%= @mail_today.near_limit? ? 'text-warning' : 'text-ink' %>">
        <%= t(".emails_count", count: @mail_today.recipients_count, limit: MailDeliveryDay.daily_limit) %>
      </p>
      <div class="min-w-0 flex-1 basis-64 space-y-1 text-sm">
        <p class="text-muted"><%= t(".emails_body") %></p>
        <% if @mail_today.near_limit? %>
          <p class="text-warning"><%= t(".emails_near_limit", percent: (MailDeliveryDay.alert_ratio * 100).round) %></p>
        <% end %>
        <% if @mail_failed.positive? %>
          <p class="text-warning"><%= t(".emails_failed", count: @mail_failed) %></p>
        <% end %>
      </div>
    </div>
  </section>

  <%# The generation machine is one workstation: how much it drew today, and
      how long clients waited for it. A wait that grows is the first sign it
      no longer keeps up (decided on 16/10/2026). %>
  <section id="generation_load" aria-labelledby="load-title">
    <h2 id="load-title" class="label-rule border-b border-line pb-3"><%= t(".load") %></h2>
    <div class="panel mt-4 p-4 <%= 'border-l-2 border-l-warning' if @load.slow? %>">
      <dl class="grid gap-4 sm:grid-cols-4">
        <div>
          <dt class="label-rule"><%= t(".load_images") %></dt>
          <dd class="mt-1 font-display text-4xl font-bold text-ink"><%= @load.images_today %></dd>
          <dd class="text-sm text-muted">
            <%= t(".load_split", creations: @load.creations_today, reprises: @load.reprises_today) %>
          </dd>
        </div>
        <div>
          <dt class="label-rule"><%= t(".load_wait") %></dt>
          <dd class="mt-1 font-display text-4xl font-bold <%= @load.slow? ? 'text-warning' : 'text-ink' %>">
            <%= @load.mean_wait_today ? duration_in_words_short(@load.mean_wait_today) : "—" %>
          </dd>
          <% if @load.longest_wait_today %>
            <dd class="text-sm text-muted"><%= t(".load_longest", wait: duration_in_words_short(@load.longest_wait_today)) %></dd>
          <% end %>
        </div>
        <div>
          <dt class="label-rule"><%= t(".load_peak") %></dt>
          <% if (peak = @load.busiest_hour_today) %>
            <dd class="mt-1 font-display text-4xl font-bold text-ink"><%= peak.last %></dd>
            <dd class="text-sm text-muted"><%= t(".load_peak_hour", from: peak.first, to: peak.first + 1) %></dd>
          <% else %>
            <dd class="mt-1 font-display text-4xl font-bold text-muted">—</dd>
          <% end %>
        </div>
        <div>
          <dt class="label-rule"><%= t(".load_failed") %></dt>
          <dd class="mt-1 font-display text-4xl font-bold <%= @load.failed_today.positive? ? 'text-warning' : 'text-muted' %>">
            <%= @load.failed_today %>
          </dd>
        </div>
      </dl>

      <% week = @load.last_week %>
      <% top = [ week.map(&:images).max, 1 ].max %>
      <figure class="mt-6">
        <figcaption class="label-rule"><%= t(".load_week") %></figcaption>
        <ol class="mt-3 flex h-24 items-end gap-2">
          <% week.each do |day| %>
            <li class="flex flex-1 flex-col items-center gap-1" title="<%= t(".load_day", date: l(day.date, format: :short), count: day.images) %>">
              <span class="text-xs text-muted"><%= day.images %></span>
              <span class="w-full rounded-xs bg-emulsion" style="height: <%= (day.images * 56 / top.to_f).round %>px" aria-hidden="true"></span>
              <span class="text-xs text-muted"><%= l(day.date, format: "%a") %></span>
            </li>
          <% end %>
        </ol>
      </figure>

      <p class="mt-4 text-sm text-muted"><%= t(".load_body") %></p>
      <% if @load.slow? %>
        <p class="mt-1 text-sm text-warning"><%= t(".load_slow", wait: duration_in_words_short(GenerationLoad.alert_wait_seconds)) %></p>
      <% end %>
    </div>
  </section>

  <%# Designers whose disputes keep ending with the client refunded (decided
      on 08/10/2026). A signal for the administration, never shown publicly. %>
  <% if @disputing.any? %>
    <section>
      <h2 class="label-rule border-b border-line pb-3"><%= t(".lost_disputes") %></h2>
      <ul class="mt-4 space-y-2">
        <% @disputing.each do |profile| %>
          <li class="panel flex flex-wrap items-center gap-4 border-l-2 border-l-warning p-4">
            <div class="min-w-0 flex-1">
              <p class="font-medium">
                <%= link_to profile.display_name, designer_path(profile),
                      class: "underline-offset-4 hover:underline" %>
              </p>
              <p class="mt-0.5 text-sm text-muted">
                <%= t(".lost_disputes_body", days: Rails.application.config.tshirt.reviews[:dispute_alert_days]) %>
              </p>
            </div>
            <p class="font-display text-2xl font-bold text-warning"><%= @lost_disputes[profile.id] %></p>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%# Designers handing work back more often than the platform expects. Not a
      sanction, a signal: usually the levels are wrong, sometimes the designer
      is picking. %>
  <section>
    <h2 class="label-rule border-b border-line pb-3"><%= t(".return_rates") %></h2>

    <% if @returning.any? %>
      <ul class="mt-4 space-y-2">
        <% @returning.each do |profile| %>
          <li class="panel flex flex-wrap items-center gap-4 border-l-2 border-l-warning p-4">
            <div class="min-w-0 flex-1">
              <p class="font-medium">
                <%= link_to profile.display_name, designer_path(profile),
                      class: "underline-offset-4 hover:underline" %>
              </p>
              <p class="mt-0.5 text-sm text-muted"><%= t(".return_rate_body") %></p>
            </div>
            <p class="font-display text-2xl font-bold text-warning">
              <%= number_to_percentage(@return_rates[profile.id] * 100, precision: 0) %>
            </p>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-4 text-muted">
        <%= t(".no_return_alert",
              threshold: number_to_percentage(
                Rails.application.config.tshirt.reviews[:return_rate_alert_threshold] * 100,
                precision: 0)) %>
      </p>
    <% end %>
  </section>

  <section>
    <h2 class="label-rule border-b border-line pb-3"><%= t(".platform") %></h2>
    <p class="mt-4 text-muted"><%= t(".platform_body") %></p>
    <%= link_to t(".see_status"), admin_status_path, class: "btn btn-secondary mt-4 text-sm" %>
  </section>
</div>
