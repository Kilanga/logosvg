<div style="font-family:Helvetica,Arial,sans-serif;color:#1D2433;max-width:600px;">
  <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#1F5F7A;margin:0 0 8px;">
    <%= t("mailers.print_request.to_client.eyebrow", reference: @print_request.token.first(8).upcase) %>
  </p>

  <h1 style="font-size:24px;margin:0 0 16px;">
    <%= t("mailers.print_request.to_client.heading", printer: @print_request.printer.name) %>
  </h1>

  <p style="margin:0 0 24px;line-height:1.5;">
    <%= t("mailers.print_request.to_client.body", printer: @print_request.printer.name) %>
  </p>

  <p style="margin:0 0 32px;">
    <a href="<%= print_request_url(@print_request) %>"
       style="display:inline-block;background:#1F5F7A;color:#FFFFFF;padding:14px 24px;
              text-decoration:none;font-weight:600;border-radius:2px;">
      <%= t("mailers.print_request.to_client.follow") %>
    </a>
  </p>

  <h2 style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#505A67;
             margin:0 0 8px;padding-top:16px;border-top:1px solid #C8D0D4;">
    <%= t("mailers.print_request.to_client.sheet_title") %>
  </h2>
  <%= render "sheet", sheet: @sheet %>

  <p style="margin:24px 0 0;padding-top:16px;border-top:1px solid #C8D0D4;line-height:1.5;color:#505A67;">
    <%= t("mailers.print_request.to_client.quote_off_platform") %>
  </p>
</div>
