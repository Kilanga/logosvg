<div style="font-family:Helvetica,Arial,sans-serif;color:#1D2433;max-width:600px;">
  <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#1F5F7A;margin:0 0 8px;">
    <%= t("mailers.print_request.canceled_to_printer.eyebrow", reference: @print_request.token.first(8).upcase) %>
  </p>

  <h1 style="font-size:24px;margin:0 0 16px;">
    <%= t("mailers.print_request.canceled_to_printer.heading", client: @print_request.contact_name) %>
  </h1>

  <p style="margin:0 0 24px;line-height:1.5;">
    <%= t("mailers.print_request.canceled_to_printer.body", client: @print_request.contact_name) %>
  </p>

  <p style="margin:0;padding-top:16px;border-top:1px solid #C8D0D4;line-height:1.5;color:#505A67;">
    <%= t("mailers.print_request.canceled_to_printer.reply_to", email: @print_request.contact_email) %>
  </p>
</div>
