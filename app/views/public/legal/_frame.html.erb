<%# Every legal page has the same shape: a title, a date, and prose set at a
    readable measure. Nothing decorative — these are read once, carefully. %>
<div class="mx-auto w-full max-w-2xl px-5 py-12">
  <p class="label-rule text-emulsion"><%= t("legal.eyebrow") %></p>
  <h1 class="mt-2 font-display text-4xl font-bold uppercase leading-tight"><%= title %></h1>
  <p class="mt-3 text-sm text-muted">
    <%= t("legal.updated", date: l(Date.parse(t("legal.updated_on")), format: :long)) %>
  </p>

  <%# A placeholder said out loud rather than a page that looks finished and
      is not. See docs/SPEC.md, "Validation juridique". %>
  <div class="mt-6 border-l-2 border-warning bg-warning-bg px-4 py-3">
    <p class="font-semibold text-warning"><%= t("legal.draft_title") %></p>
    <p class="mt-1 text-sm text-warning"><%= t("legal.draft_body") %></p>
  </div>

  <div class="legal mt-10 space-y-8"><%= yield %></div>

  <nav class="mt-16 border-t border-line pt-6" aria-label="<%= t("legal.other_pages") %>">
    <p class="label-rule"><%= t("legal.other_pages") %></p>
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      <% legal_pages.each do |key, path| %>
        <li>
          <%= link_to t("legal.#{key}.title"), path,
                class: class_names("underline-offset-4 hover:underline",
                                   @page == key ? "font-medium text-emulsion" : "text-muted") %>
        </li>
      <% end %>
    </ul>
  </nav>
</div>
