<% content_for :title, t(".title", name: @printer.name) %>

<%# The shop's page for its own clients: the poster lands here. It speaks for the
    shop, not for the platform — the platform's own home page is for workshops.
    What it offers at the foot depends on who is looking: a visitor, a client of
    this shop, a client waiting on it, or one who belongs elsewhere. %>
<section class="border-b border-line bg-surface">
  <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-8 px-5 py-12 lg:py-16">
    <% if @printer.logo.attached? %>
      <%= image_tag @printer.logo.variant(resize_to_fill: [ 200, 200 ]), alt: "",
            class: "size-28 flex-none rounded-xs border border-line object-cover" %>
    <% end %>

    <div class="min-w-0 flex-1 basis-80">
      <p class="label-rule text-emulsion"><%= [ @printer.postal_code, @printer.city ].compact_blank.join(" ") %></p>
      <h1 class="mt-3 text-4xl font-bold uppercase leading-[0.95] sm:text-5xl"><%= @printer.name %></h1>
      <p class="mt-4 max-w-2xl text-lg"><%= t(".lead", name: @printer.name) %></p>
    </div>
  </div>
</section>

<div class="mx-auto grid w-full max-w-6xl gap-10 px-5 py-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-start lg:py-16">
  <div class="space-y-10">
    <section>
      <h2 class="label-rule"><%= t(".how.title") %></h2>
      <ol class="mt-4 space-y-4">
        <% t(".how.steps").each_with_index do |step, index| %>
          <li class="flex gap-4">
            <span class="font-display text-2xl font-bold text-emulsion"><%= index + 1 %></span>
            <span>
              <span class="block font-display text-base font-bold uppercase tracking-[0.04em]"><%= step[:title] %></span>
              <span class="mt-1 block text-muted"><%= step[:body] %></span>
            </span>
          </li>
        <% end %>
      </ol>
    </section>

    <% if @printer.techniques.any? %>
      <section>
        <h2 class="label-rule"><%= t(".techniques") %></h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          <% @printer.techniques.each do |technique| %>
            <li class="chip-file"><%= technique.display_label %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @printer.description.present? %>
      <section>
        <h2 class="label-rule"><%= t(".about") %></h2>
        <p class="mt-3 whitespace-pre-line"><%= @printer.description %></p>
        <%= link_to t(".full_page"), printer_path(@printer.slug),
              class: "mt-3 inline-block text-sm underline underline-offset-4 hover:text-emulsion" %>
      </section>
    <% end %>
  </div>

  <%# First on a phone — the poster is scanned with one — beside the
      explanation on a wider screen. %>
  <aside class="panel order-first p-6 lg:order-none" aria-labelledby="join-title">
    <h2 id="join-title" class="font-display text-xl font-bold uppercase"><%= t(".join.title") %></h2>

    <% if Current.user.nil? %>
      <p class="mt-3 text-sm"><%= @invited ? t(".join.invited", name: @printer.name) : t(".join.ask", name: @printer.name) %></p>
      <div class="mt-6 flex flex-col gap-3">
        <%= link_to t(".join.sign_up"), new_registration_path, class: "btn btn-primary" %>
        <%= link_to t(".join.sign_in"), new_session_path, class: "btn btn-secondary" %>
      </div>

    <% elsif !Current.user.client? %>
      <p class="mt-3 text-sm text-muted"><%= t(".join.not_a_client") %></p>

    <% elsif Current.user.workshop_id == @printer.id %>
      <p class="mt-3 text-sm"><%= t(".join.member", name: @printer.name) %></p>
      <%= link_to t("nav.create"), new_design_path, class: "btn btn-primary mt-6 w-full" %>

    <% elsif @pending %>
      <p class="mt-3 flex items-start gap-3 border-l-2 border-warning bg-warning-bg px-4 py-3 text-sm text-warning">
        <%= t(".join.pending", name: @printer.name) %>
      </p>

    <% else %>
      <p class="mt-3 text-sm">
        <%= Current.user.attached_to_workshop? ? t(".join.switch", name: @printer.name) : t(".join.ask", name: @printer.name) %>
      </p>
      <%= button_to t(@invited ? ".join.join" : ".join.request"), join_workshop_path(slug: @printer.slug),
            class: "btn btn-primary mt-6 w-full", form_class: "contents" %>
    <% end %>
  </aside>
</div>
