<% content_for :title, t("help.client.title") %>

<section class="border-b border-line bg-surface">
  <div class="mx-auto w-full max-w-4xl px-5 py-12 lg:py-16">
    <p class="label-rule text-emulsion"><%= t("help.client.eyebrow") %></p>
    <h1 class="mt-3 text-4xl font-bold uppercase leading-[0.95] sm:text-5xl"><%= t("help.client.heading") %></h1>
    <p class="mt-4 max-w-2xl text-lg"><%= t("help.client.lead") %></p>
  </div>
</section>

<div class="mx-auto w-full max-w-4xl px-5 py-12 lg:py-16">
  <%= render "shared/faq", groups: t("help.client.groups"), id_prefix: "faq-client" %>

  <aside class="panel mt-12 p-6">
    <h2 class="font-display text-xl font-bold uppercase"><%= t("help.client.contact") %></h2>
    <p class="mt-3 text-sm"><%= help_text(t("help.client.contact_body")) %></p>
    <%= link_to t("help.client.contact_cta"), contact_path, class: "btn btn-secondary mt-4 text-sm" %>
  </aside>
</div>
