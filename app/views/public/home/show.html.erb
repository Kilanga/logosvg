<%# Landing page for print shops. Sections follow docs/SPEC.md, "Écrans et routes". %>

<%# --- Hero ---------------------------------------------------------------- %>
<section class="border-b border-line bg-surface">
  <div class="mx-auto grid w-full max-w-6xl gap-12 px-5 py-16 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:py-24">
    <div>
      <p class="label-rule text-emulsion"><%= t(".eyebrow") %></p>

      <h1 class="mt-4 text-4xl font-bold uppercase leading-[0.95] sm:text-5xl lg:text-6xl">
        <%= t(".headline_lead") %>
        <span class="block text-emulsion"><%= t(".headline_accent") %></span>
      </h1>

      <p class="mt-6 max-w-md text-lg text-muted"><%= t(".subhead") %></p>

      <div class="mt-8 flex flex-wrap gap-3">
        <%# Sign-up arrives with step 1. %>
        <span class="btn btn-primary"><%= t(".cta_primary") %></span>
        <a href="#fonctionnement" class="btn btn-secondary"><%= t(".cta_secondary") %></a>
      </div>
    </div>

    <%= render "public/home/separation_demo" %>
  </div>
</section>

<%# --- 01 Fonctionnement ---------------------------------------------------- %>
<section id="fonctionnement" class="mx-auto w-full max-w-6xl px-5 py-16 lg:py-20">
  <header class="flex items-baseline gap-4 border-b border-line pb-4">
    <span class="font-display text-2xl font-bold text-emulsion">01</span>
    <h2 class="text-2xl font-bold uppercase lg:text-3xl"><%= t(".how.title") %></h2>
  </header>

  <ol class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
    <% t(".how.steps").each_with_index do |step, index| %>
      <li class="border-t-2 border-ink pt-4">
        <p class="label-rule"><%= format("%02d", index + 1) %></p>
        <h3 class="mt-2 text-xl font-bold"><%= step[:title] %></h3>
        <p class="mt-2 text-muted"><%= step[:body] %></p>
      </li>
    <% end %>
  </ol>
</section>

<%# --- 02 L'email reçu par l'atelier ---------------------------------------- %>
<section class="border-y border-line bg-surface">
  <div class="mx-auto w-full max-w-6xl px-5 py-16 lg:py-20">
    <header class="flex items-baseline gap-4 border-b border-line pb-4">
      <span class="font-display text-2xl font-bold text-emulsion">02</span>
      <h2 class="text-2xl font-bold uppercase lg:text-3xl"><%= t(".email.title") %></h2>
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,4fr)_minmax(0,6fr)] lg:items-start">
      <p class="text-lg text-muted"><%= t(".email.body") %></p>

      <%# Faithful mock of the order email, so a print shop knows exactly what
          lands in its inbox before subscribing. %>
      <div class="panel overflow-hidden bg-paper">
        <dl class="divide-y divide-line border-b border-line text-sm">
          <% t(".email.headers").each do |row| %>
            <div class="flex gap-4 px-4 py-2">
              <dt class="label-rule w-20 flex-none pt-0.5"><%= row[:label] %></dt>
              <dd class="min-w-0 font-medium"><%= row[:value] %></dd>
            </div>
          <% end %>
        </dl>

        <div class="space-y-4 bg-surface p-4">
          <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-3">
            <% t(".email.specs").each do |spec| %>
              <div>
                <dt class="label-rule"><%= spec[:label] %></dt>
                <dd class="mt-0.5 font-semibold"><%= spec[:value] %></dd>
              </div>
            <% end %>
          </dl>

          <div class="flex flex-wrap items-center gap-2 border-t border-line pt-4">
            <span class="label-rule me-1"><%= t(".email.attachments_label") %></span>
            <% t(".email.attachments").each do |file| %>
              <span class="chip-file"><%= file %></span>
            <% end %>
          </div>

          <p class="border-t border-line pt-4">
            <span class="btn btn-primary w-full sm:w-auto"><%= t(".email.confirm_button") %></span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<%# --- 03 Abonnements -------------------------------------------------------- %>
<section class="mx-auto w-full max-w-6xl px-5 py-16 lg:py-20">
  <header class="flex items-baseline gap-4 border-b border-line pb-4">
    <span class="font-display text-2xl font-bold text-emulsion">03</span>
    <h2 class="text-2xl font-bold uppercase lg:text-3xl"><%= t(".plans.title") %></h2>
  </header>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    <% t(".plans.items").each_with_index do |plan, index| %>
      <article class="panel flex flex-col p-6 <%= "border-emulsion border-2" if index == 1 %>">
        <div class="flex items-start justify-between gap-4">
          <h3 class="text-2xl font-bold uppercase"><%= plan[:name] %></h3>
          <% if index == 1 %>
            <span class="pill pill-success"><%= t(".plans.highlighted") %></span>
          <% end %>
        </div>

        <p class="mt-2 text-muted"><%= plan[:summary] %></p>

        <%# ⚠ DÉCISION OUVERTE : le prix des deux abonnements n'est pas arrêté.
            Rien n'est affiché plutôt qu'un montant inventé. %>
        <p class="mt-6 font-display text-xl font-bold text-muted"><%= t(".plans.price_pending") %></p>

        <ul class="mt-6 space-y-2.5 border-t border-line pt-6 text-sm">
          <% plan[:features].each do |feature| %>
            <li class="flex gap-3">
              <%= registration_mark css_class: "mt-0.5 flex-none text-emulsion" %>
              <span><%= feature %></span>
            </li>
          <% end %>
        </ul>
      </article>
    <% end %>
  </div>
</section>

<%# --- 04 Appel aux graphistes ---------------------------------------------- %>
<section class="border-t border-line bg-surface">
  <div class="mx-auto w-full max-w-6xl px-5 py-16 lg:py-20">
    <header class="flex items-baseline gap-4 border-b border-line pb-4">
      <span class="font-display text-2xl font-bold text-emulsion">04</span>
      <h2 class="text-2xl font-bold uppercase lg:text-3xl"><%= t(".designers.title") %></h2>
    </header>

    <div class="mt-10 flex flex-wrap items-end justify-between gap-8">
      <p class="max-w-xl text-lg text-muted"><%= t(".designers.body") %></p>
      <%# Designer sign-up arrives with step 7. %>
      <span class="btn btn-secondary"><%= t(".designers.cta") %></span>
    </div>
  </div>
</section>
