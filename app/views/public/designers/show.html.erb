<% content_for :title, @designer.display_name %>

<div class="mx-auto w-full max-w-5xl px-5 py-10">
  <%# The owner previewing a profile that is not public yet. %>
  <% unless @designer.active? %>
    <div class="mb-6 border-l-2 border-warning bg-warning-bg px-4 py-3">
      <p class="font-semibold text-warning"><%= t(".preview_only") %></p>
      <p class="mt-1 text-sm text-warning"><%= t(".preview_only_body") %></p>
    </div>
  <% end %>

  <header class="flex flex-wrap items-start gap-6 border-b-2 border-ink pb-6">
    <div class="size-24 flex-none overflow-hidden rounded-xs border border-line bg-paper">
      <% if @designer.avatar.attached? %>
        <%= image_tag @designer.avatar, alt: "", class: "size-full object-cover" %>
      <% else %>
        <span class="flex size-full items-center justify-center font-display text-3xl font-bold text-muted">
          <%= @designer.display_name.first.upcase %>
        </span>
      <% end %>
    </div>

    <div class="min-w-0 flex-1">
      <h1 class="font-display text-4xl font-bold uppercase leading-none"><%= @designer.display_name %></h1>
      <p class="mt-2 text-muted">
        <%= @designer.city.presence || t("public.designers.index.remote_only") %>
        <% if @designer.remote? %> · <%= t("public.designers.index.remote") %><% end %>
      </p>
      <p class="label-rule mt-2"><%= rating_summary(@designer) %></p>
    </div>

    <p class="label-rule <%= @designer.can_take_work? ? 'text-success' : 'text-muted' %>">
      <%= availability_note(@designer) %>
    </p>
  </header>

  <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-start">
    <div class="space-y-8">
      <% if @designer.bio.present? %>
        <section>
          <h2 class="label-rule"><%= t(".about") %></h2>
          <p class="mt-3 whitespace-pre-line"><%= @designer.bio %></p>
        </section>
      <% end %>

      <%# The portfolio on a screen tint, like every other preview in the
          application: it is printed work being shown. %>
      <% if @designer.portfolio.attached? %>
        <section>
          <h2 class="label-rule"><%= t(".portfolio") %></h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-3">
            <% @designer.portfolio.each do |piece| %>
              <li class="screen-tint aspect-square overflow-hidden rounded-xs border border-line p-2">
                <%= image_tag piece, alt: "", class: "size-full object-contain" %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>

    <aside class="space-y-6">
      <div class="panel p-5">
        <h2 class="label-rule"><%= t(".levels") %></h2>
        <% if @designer.review_levels.any? %>
          <ul class="mt-3 space-y-3">
            <% @designer.review_levels.each do |level| %>
              <li class="border-b border-line pb-3 last:border-0 last:pb-0">
                <p class="flex items-baseline justify-between gap-3">
                  <span class="font-medium"><%= level.name %></span>
                  <span class="font-display font-bold text-emulsion"><%= level_price(level) %></span>
                </p>
                <p class="label-rule mt-1 text-muted"><%= level_terms(level) %></p>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="mt-3 text-sm text-muted"><%= t(".no_level") %></p>
        <% end %>
      </div>

      <% if @designer.specialties.any? %>
        <div class="panel p-5">
          <h2 class="label-rule"><%= t(".specialties") %></h2>
          <ul class="mt-3 flex flex-wrap gap-1.5">
            <% @designer.specialties.each do |specialty| %>
              <li class="pill border border-line text-muted">
                <%= t("enums.designer_profile.specialties.#{specialty}") %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @designer.languages.any? %>
        <div class="panel p-5">
          <h2 class="label-rule"><%= t(".languages") %></h2>
          <p class="mt-2 text-sm">
            <%= @designer.languages.map { |l| t("enums.designer_profile.languages.#{l}") }.join(", ") %>
          </p>
        </div>
      <% end %>

      <%# Asking for a review is step 8. Saying so beats a button that does
          nothing. %>
      <div class="panel p-5">
        <p class="label-rule flex items-center gap-2.5 text-emulsion">
          <%= registration_mark %><%= t(".ask_title") %>
        </p>
        <p class="mt-3 text-sm text-muted"><%= t(".ask_body") %></p>
      </div>
    </aside>
  </div>
</div>
