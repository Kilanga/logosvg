<%# One shop in the directory list. A row with a hairline rule rather than a
    floating card: the list reads as a register, which is what it is — except
    for a prominent Atelier+, singled out with a thin gold frame rather than
    folded into the same rule as everyone else. %>
<% prominent = printer.prominent?(near: local_assigns[:near]) %>
<% design = local_assigns[:design] %>
<% compatibility = local_assigns[:compatibility] %>
<% incompatible = compatibility.present? && !compatibility.compatible? %>
<li class="<%= [ (prominent ? "frame-featured -mx-4 px-4 py-5 sm:-mx-5 sm:px-5" : "py-6"),
                 ("opacity-60" if incompatible) ].compact.join(" ") %>">
  <article class="flex flex-wrap items-start gap-x-6 gap-y-4">
    <% if printer.logo.attached? %>
      <%= image_tag printer.logo.variant(resize_to_fill: [ 96, 96 ]),
            alt: "", loading: "lazy",
            class: "size-16 flex-none rounded-xs border border-line object-cover" %>
    <% else %>
      <div class="screen-tint flex size-16 flex-none items-center justify-center rounded-xs border border-line text-emulsion">
        <%= registration_mark %>
      </div>
    <% end %>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h2 class="font-display text-xl font-bold uppercase">
          <%= link_to printer.name, printer_path(printer), class: "hover:text-emulsion" %>
        </h2>
        <% if prominent %>
          <span class="pill pill-featured"><%= t("printers.featured") %></span>
        <% end %>
      </div>

      <p class="mt-1 text-sm text-muted">
        <%= [ printer.postal_code, printer.city ].compact_blank.join(" ") %>
      </p>

      <% if printer.description.present? %>
        <p class="mt-2 line-clamp-2 text-sm"><%= printer.description %></p>
      <% end %>

      <ul class="mt-3 flex flex-wrap gap-2">
        <% printer.techniques.each do |technique| %>
          <li class="chip-file"><%= technique_summary(technique) %></li>
        <% end %>
      </ul>
    </div>

    <ul class="flex flex-none flex-wrap gap-2 text-sm text-muted">
      <% if printer.ships? %><li class="chip-file"><%= t("printers.ships") %></li><% end %>
      <% if printer.pickup? %><li class="chip-file"><%= t("printers.pickup") %></li><% end %>
      <% if printer.express_available? %><li class="chip-file"><%= t("printers.express") %></li><% end %>
    </ul>
  </article>

  <%# With a design in context: say whether it fits here, and offer the one
      action that follows from the answer — never both buttons at once. %>
  <% if design.present? %>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4 text-sm">
      <% if incompatible %>
        <p class="max-w-md text-warning"><%= compatibility.message %></p>
        <%= link_to t("public.printers.card.recreate_for"), workshop_link_path(slug: printer.slug),
              class: "flex-none font-medium text-emulsion underline underline-offset-4" %>
      <% else %>
        <span class="flex items-center gap-2 text-success">
          <%= registration_mark css_class: "flex-none" %><%= t("public.printers.card.compatible") %>
        </span>
        <%= link_to t("public.printers.card.send_to"),
              new_design_print_request_path(design, atelier: printer.slug),
              class: "flex-none font-medium text-emulsion underline underline-offset-4" %>
      <% end %>
    </div>
  <% end %>
</li>
