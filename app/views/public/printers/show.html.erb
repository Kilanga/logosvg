<% content_for :title, @printer.name %>

<div class="mx-auto w-full max-w-6xl px-5 py-10 lg:py-14">
  <% unless @printer.listed? %>
    <%# Only the owner can be here, and they should know what they are looking at. %>
    <p class="mb-6 flex items-center gap-3 border-l-2 border-warning bg-warning-bg px-4 py-3 text-sm text-warning">
      <%= registration_mark %>
      <%= t(".preview", status: t("enums.printer.status.#{@printer.status}").downcase) %>
    </p>
  <% end %>

  <header class="flex flex-wrap items-start gap-6 border-b border-line pb-8">
    <% if @printer.logo.attached? %>
      <%= image_tag @printer.logo.variant(resize_to_fill: [ 160, 160 ]), alt: "",
            class: "size-24 flex-none rounded-xs border border-line object-cover" %>
    <% end %>

    <div class="min-w-0 flex-1">
      <p class="label-rule text-emulsion"><%= [ @printer.postal_code, @printer.city ].compact_blank.join(" ") %></p>
      <h1 class="mt-2 text-3xl font-bold uppercase lg:text-4xl"><%= @printer.name %></h1>

      <ul class="mt-4 flex flex-wrap gap-2">
        <% if @printer.featured? %><li class="pill pill-success"><%= t("printers.featured") %></li><% end %>
        <% unless @printer.label_none? %>
          <li class="pill pill-success"><%= t("enums.printer.textile_label.#{@printer.textile_label}") %></li>
        <% end %>
        <% if @printer.response_time_hours.present? %>
          <li class="chip-file"><%= t("printers.responds_within", count: @printer.response_time_hours) %></li>
        <% end %>
      </ul>
    </div>
  </header>

  <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-start">
    <div class="space-y-10">
      <% if @printer.description.present? %>
        <section>
          <h2 class="label-rule"><%= t(".about") %></h2>
          <p class="mt-3 whitespace-pre-line text-lg"><%= @printer.description %></p>
        </section>
      <% end %>

      <section>
        <h2 class="label-rule"><%= t(".techniques") %></h2>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          <% @printer.techniques.each do |technique| %>
            <li class="flex flex-wrap items-baseline justify-between gap-3 py-3">
              <span class="font-display text-lg font-bold uppercase">
                <%= t("enums.printer_technique.technique.#{technique.technique}") %>
              </span>
              <span class="text-sm text-muted">
                <% if technique.unlimited_colours? %>
                  <%= t("printers.unlimited_colors") %>
                <% else %>
                  <%= t("printers.colors", count: technique.max_colors) %>
                <% end %>
                <% if technique.accepted_formats.any? %>
                  · <%= technique.accepted_formats.map(&:upcase).join(", ") %>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </section>

      <%= render "characteristics", printer: @printer %>
    </div>

    <aside class="space-y-6">
      <div class="panel p-6">
        <h2 class="label-rule"><%= t(".contact") %></h2>
        <dl class="mt-4 space-y-3 text-sm">
          <% if @printer.full_address.present? %>
            <div>
              <dt class="label-rule"><%= t("activerecord.attributes.printer.address") %></dt>
              <dd class="mt-1"><%= @printer.full_address %></dd>
            </div>
          <% end %>
          <% if @printer.phone.present? %>
            <div>
              <dt class="label-rule"><%= t("activerecord.attributes.printer.phone") %></dt>
              <dd class="mt-1"><%= link_to @printer.phone, "tel:#{@printer.phone}", class: "underline underline-offset-4" %></dd>
            </div>
          <% end %>
          <% if @printer.website.present? %>
            <div>
              <dt class="label-rule"><%= t("activerecord.attributes.printer.website") %></dt>
              <dd class="mt-1 break-all">
                <%= link_to @printer.website, @printer.website, rel: "noopener nofollow",
                      class: "underline underline-offset-4" %>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>

      <% if @printer.located? %>
        <div class="panel overflow-hidden">
          <%= tag.div class: "screen-tint h-64 w-full",
                data: {
                  controller: "map",
                  map_points_value: map_points([ @printer ]).to_json,
                  map_zoom_value: 13,
                  attribution: t("public.printers.index.osm_attribution")
                } %>
        </div>
      <% end %>
    </aside>
  </div>

  <% if @printer.photos.attached? %>
    <section class="mt-12 border-t border-line pt-8">
      <h2 class="label-rule"><%= t(".photos") %></h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <% @printer.photos.each do |photo| %>
          <li>
            <%= image_tag photo.variant(resize_to_fill: [ 600, 400 ]), alt: "", loading: "lazy",
                  class: "aspect-[3/2] w-full rounded-xs border border-line object-cover" %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
