<%# The rows come from PrintersHelper#printer_characteristics. A group with
    nothing filled in is dropped rather than shown empty: a sparse listing says
    only what it actually says. See docs/SPEC.md, "caractéristiques par groupe". %>
<% printer_characteristics(printer).each do |group, rows| %>
  <% filled = rows.reject { |_, value| value.blank? } %>
  <% next if filled.empty? %>

  <section>
    <h2 class="label-rule"><%= t(".groups.#{group}") %></h2>

    <dl class="mt-3 divide-y divide-line border-y border-line">
      <% filled.each do |label, value| %>
        <div class="flex flex-wrap gap-x-6 gap-y-1 py-3">
          <dt class="w-56 flex-none text-sm text-muted"><%= label %></dt>
          <dd class="min-w-0 flex-1"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </section>
<% end %>
