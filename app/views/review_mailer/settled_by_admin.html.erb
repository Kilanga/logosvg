<%= render "frame",
      tone: "#6B4200",
      eyebrow: t("mailers.review.settled_by_admin.eyebrow"),
      heading: t("mailers.review.settled_by_admin.heading"),
      body: @review.admin_note,
      notice: [ (t("mailers.review.settled_by_admin.refunded", amount: money(@amount_cents)) if @amount_cents.positive?),
                (t("mailers.review.settled_by_admin.designer_paid", amount: money(@review.designer_payout_cents)) if @review.designer_payout_cents.to_i.positive?) ].compact.join(" ").presence,
      url: @for_designer ? designer_review_url(@review) : review_url(@review),
      action: t("mailers.review.settled_by_admin.action") %>
