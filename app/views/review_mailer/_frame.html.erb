<%# The shape every review email shares: a label, a headline, a paragraph or
    two, and one thing to do. Styles are inline because email clients strip
    stylesheets. %>
<div style="font-family:Helvetica,Arial,sans-serif;color:#1D2433;max-width:600px;">
  <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;
            color:<%= local_assigns.fetch(:tone, "#1F5F7A") %>;margin:0 0 8px;">
    <%= eyebrow %>
  </p>

  <h1 style="font-size:24px;margin:0 0 16px;"><%= heading %></h1>

  <p style="margin:0 0 24px;line-height:1.5;"><%= body %></p>

  <% if local_assigns[:notice].present? %>
    <p style="margin:0 0 24px;line-height:1.5;border-left:2px solid #6B4200;
              background:#FFF3DC;padding:12px 16px;"><%= notice %></p>
  <% end %>

  <%= yield if block_given? %>

  <% if local_assigns[:url].present? %>
    <p style="margin:0 0 32px;">
      <a href="<%= url %>"
         style="display:inline-block;background:#1F5F7A;color:#FFFFFF;padding:14px 24px;
                text-decoration:none;font-weight:600;border-radius:2px;">
        <%= action %>
      </a>
    </p>
  <% end %>

  <% if local_assigns[:footer].present? %>
    <p style="margin:0;padding-top:16px;border-top:1px solid #C8D0D4;line-height:1.5;color:#505A67;">
      <%= footer %>
    </p>
  <% end %>
</div>
