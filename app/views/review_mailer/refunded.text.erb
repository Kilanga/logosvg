<%= render "frame",
      eyebrow: t("mailers.review.refunded.eyebrow"),
      heading: t("mailers.review.refunded.heading", amount: number_to_currency(@amount_cents / 100.0, unit: "€", format: "%n %u")),
      body: t("mailers.review.refunded.body"),
      notice: (t("mailers.review.refunded.guaranteed", amount: number_to_currency(@review.guaranteed_share_cents / 100.0, unit: "€", format: "%n %u")) if @review.canceled? && @review.designer_payout_cents.to_i.positive?),
      url: design_url(@review.design),
      action: t("mailers.review.refunded.action") %>
