<%= render "frame",
      eyebrow: t("mailers.review.notify_designers.eyebrow", reference: @review.token.first(8).upcase),
      heading: t("mailers.review.notify_designers.heading", level: @review.review_level.name),
      body: t("mailers.review.notify_designers.body", brief: @review.client_brief.presence || t("mailers.review.notify_designers.no_brief")),
      url: designer_review_url(@review),
      action: t("mailers.review.notify_designers.action"),
      footer: (@review.off_platform? ? t("mailers.review.notify_designers.footer_off_platform") :
               t("mailers.review.notify_designers.footer", amount: money(@review.designer_share_cents))) %>
