<%= render "frame",
      eyebrow: t("mailers.review.client_contact.eyebrow"),
      heading: t("mailers.review.client_contact.heading", client: @client.full_name),
      body: t("mailers.review.client_contact.body",
              brief: @review.client_brief.presence || t("mailers.review.notify_designers.no_brief")),
      notice: [ t("mailers.review.client_contact.email", email: @client.email_address),
                (@client.phone.present? ? t("mailers.review.client_contact.phone", phone: @client.phone) :
                                          t("mailers.review.client_contact.no_phone")) ].join(" — "),
      url: designer_review_url(@review),
      action: t("mailers.review.client_contact.action") %>
