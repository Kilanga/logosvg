<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading") %>

<div class="max-w-3xl">
  <p class="mb-8 text-muted"><%= t(".intro") %></p>

  <% if context_printer %>
    <div class="panel mb-8 flex flex-wrap items-center justify-between gap-4 p-4">
      <p class="flex items-center gap-3 text-sm">
        <%= registration_mark css_class: "text-emulsion" %>
        <span><%= t("client.designs.new.for_workshop_html", name: tag.strong(context_printer.name)) %></span>
      </p>
      <%= link_to t("client.designs.new.change_workshop"), printers_path,
            class: "text-sm underline underline-offset-4 hover:text-emulsion" %>
    </div>
  <% end %>

  <%= form_with model: @design, url: design_uploads_path, multipart: true, class: "space-y-10",
        data: {
          controller: "design-form",
          design_form_families_value: available_techniques.to_h { |e| [ e.key, e.family ] }.to_json,
          design_form_ceilings_value: available_techniques.to_h { |e| [ e.key, e.max_colors ] }.to_json
        } do |form| %>

    <%# The picture first: it is the whole request. %>
    <fieldset>
      <div class="flex items-baseline gap-4 border-b border-line pb-3">
        <span class="font-display text-xl font-bold text-emulsion">01</span>
        <legend class="font-display text-xl font-bold uppercase"><%= t(".image_legend") %></legend>
      </div>

      <div class="mt-6 space-y-5">
        <div class="rounded-xs border border-dashed border-line p-4">
          <%= form.label :reference_image, t(".image"), class: "label-rule block" %>
          <p class="mt-1.5 text-sm text-muted"><%= t(".image_hint") %></p>
          <%= form.file_field :reference_image, accept: ReferenceImage::ACCEPTED.join(","), required: true,
                class: "mt-3 block w-full text-sm file:mr-3 file:rounded-xs file:border file:border-line
                       file:bg-surface file:px-3 file:py-2" %>
          <label class="mt-3 flex items-start gap-2.5 text-sm">
            <%= form.check_box :reference_rights_confirmed, required: true,
                  class: "mt-0.5 size-4 flex-none border-line text-emulsion" %>
            <span><%= t(".rights") %></span>
          </label>
          <% if @design.errors[:reference_rights_confirmed].any? %>
            <p class="mt-1.5 text-sm text-warning"><%= @design.errors.full_messages_for(:reference_rights_confirmed).first %></p>
          <% end %>
          <%# Asked, never presumed: the platform marks as AI only what it knows
              to be. See AiProvenance. %>
          <label class="mt-3 flex items-start gap-2.5 text-sm">
            <%= form.check_box :ai_declared, class: "mt-0.5 size-4 flex-none border-line text-emulsion" %>
            <span><%= t(".ai_declared") %></span>
          </label>
          <label class="mt-3 flex items-start gap-2.5 text-sm">
            <%= form.check_box :remove_background, class: "mt-0.5 size-4 flex-none border-line text-emulsion" %>
            <span><%= t(".remove_background") %></span>
          </label>
        </div>

        <div>
          <%= form.label :prompt, t(".name"), class: "label-rule block" %>
          <%= form.text_field :prompt, maxlength: 300, value: (@design.prompt if @design.errors.any?),
                placeholder: t(".name_placeholder"),
                class: "mt-2 block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
        </div>
      </div>
    </fieldset>

    <%= render "client/designs/technique_fields", form: form, number: "02", hint: t(".technique_hint") %>

    <div>
      <%= render "client/designs/inks_field", form: form %>
    </div>

    <%= render "client/designs/size_fields", form: form, number: "03" %>

    <%= render "shared/turnstile" %>

    <div class="border-t border-line pt-8">
      <%= form.submit t(".submit"), class: "btn btn-primary w-full sm:w-auto" %>
      <p class="mt-3 text-sm text-muted"><%= t(".free") %></p>
      <p class="mt-3 text-sm">
        <%= link_to t(".back_to_generation"), new_design_path, class: "underline underline-offset-4 hover:text-emulsion" %>
      </p>
    </div>
  <% end %>
</div>
