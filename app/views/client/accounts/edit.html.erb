<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading") %>

<div class="max-w-2xl space-y-8">
  <%# Two forms, deliberately. A wrong password must not wipe out a half-typed
      address, and each says what went wrong under its own fields. %>
  <section class="panel p-6">
    <div class="flex items-baseline gap-4 border-b border-line pb-3">
      <span class="font-display text-xl font-bold text-emulsion">01</span>
      <h2 class="font-display text-xl font-bold uppercase"><%= t(".details") %></h2>
    </div>

    <%= form_with model: @user, url: client_account_path, method: :patch, class: "mt-6 space-y-5" do |form| %>
      <div class="grid gap-5 sm:grid-cols-2">
        <%= render "shared/field", form: form, field: :first_name,
              label: t("activerecord.attributes.user.first_name"), options: { required: true } %>
        <%= render "shared/field", form: form, field: :last_name,
              label: t("activerecord.attributes.user.last_name"), options: { required: true } %>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <%= render "shared/field", form: form, field: :phone,
              label: t("activerecord.attributes.user.phone"), kind: :telephone_field %>
        <%= render "shared/field", form: form, field: :city,
              label: t("activerecord.attributes.user.city") %>
      </div>

      <%# The address identifies the account, so it is shown but not edited
          here: changing it is a different job, with its own confirmation. %>
      <div>
        <p class="label-rule"><%= t("activerecord.attributes.user.email_address") %></p>
        <p class="mt-2 flex min-h-touch items-center rounded-xs border border-line bg-paper px-3 text-muted">
          <%= @user.email_address %>
        </p>
        <p class="mt-1.5 text-sm text-muted"><%= t(".email_locked") %></p>
      </div>

      <div class="border-t border-line pt-5">
        <%= form.submit t(".save"), class: "btn btn-primary" %>
      </div>
    <% end %>
  </section>

  <section class="panel p-6">
    <div class="flex items-baseline gap-4 border-b border-line pb-3">
      <span class="font-display text-xl font-bold text-emulsion">02</span>
      <h2 class="font-display text-xl font-bold uppercase"><%= t(".password") %></h2>
    </div>
    <p class="mt-3 text-sm text-muted"><%= t(".password_hint") %></p>

    <%= form_with model: @user, url: client_account_password_path, method: :patch,
          class: "mt-6 space-y-5" do |form| %>
      <%= render "shared/field", form: form, field: :current_password,
            label: t(".current_password"), kind: :password_field,
            options: { required: true, autocomplete: "current-password" } %>

      <div class="grid gap-5 sm:grid-cols-2">
        <%= render "shared/field", form: form, field: :password,
              label: t("activerecord.attributes.user.password"), kind: :password_field,
              options: { required: true, autocomplete: "new-password" } %>
        <%= render "shared/field", form: form, field: :password_confirmation,
              label: t("activerecord.attributes.user.password_confirmation"), kind: :password_field,
              options: { required: true, autocomplete: "new-password" } %>
      </div>

      <div class="border-t border-line pt-5">
        <%= form.submit t(".change_password"), class: "btn btn-primary" %>
        <p class="mt-3 text-sm text-muted"><%= t(".other_sessions") %></p>
      </div>
    <% end %>
  </section>

  <section class="panel p-6">
    <div class="flex items-baseline gap-4 border-b border-line pb-3">
      <span class="font-display text-xl font-bold text-emulsion">03</span>
      <h2 class="font-display text-xl font-bold uppercase"><%= t(".data") %></h2>
    </div>

    <p class="mt-4 text-sm text-muted"><%= t(".export_body") %></p>
    <%= link_to t(".export"), client_account_export_path, class: "btn btn-secondary mt-4 text-sm" %>

    <%# Closing the account. Kept last, asked for twice, and plain about what
        survives: a print request already sent is the workshop's record too. %>
    <div class="mt-8 border-t border-line pt-6">
      <p class="label-rule text-warning"><%= t(".close") %></p>
      <p class="mt-2 text-sm text-muted"><%= t(".close_body") %></p>
      <p class="mt-2 text-sm text-muted"><%= t(".close_kept", days: Rails.application.config.tshirt.privacy[:deleted_account_purge_days]) %></p>

      <%= form_with url: client_account_path, method: :delete, class: "mt-4 max-w-64" do %>
        <%= label_tag :current_password, t(".close_password"), class: "label-rule block" %>
        <%= password_field_tag :current_password, nil, required: true,
              autocomplete: "current-password",
              class: "mt-2 block min-h-touch w-full rounded-xs border border-line bg-surface px-3" %>
        <button type="submit" class="btn btn-secondary mt-3 text-sm"
                data-turbo-confirm="<%= t('.close_confirm') %>">
          <%= t(".close_action") %>
        </button>
      <% end %>
    </div>
  </section>
</div>
