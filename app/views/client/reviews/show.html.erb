<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading", level: @review.review_level.name) %>

<div class="grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-start">
  <div class="space-y-6">
    <%# The designer handed it back. This is the only thing on the page that
        matters until the client answers, so nothing else competes with it. %>
    <% if @review.returned_to_client? && @review.proposal_open? %>
      <section class="panel border-l-2 border-l-warning p-6">
        <p class="label-rule text-warning"><%= t(".returned") %></p>
        <p class="mt-2 font-medium"><%= t("enums.review.return_reason.#{@review.return_reason_code}") %></p>
        <p class="mt-3 whitespace-pre-line text-muted"><%= @review.return_message %></p>

        <dl class="mt-5 space-y-2 border-t border-line pt-4 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t(".proposed_level") %></dt>
            <dd class="font-medium"><%= @review.proposed_level&.name %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t(".difference") %></dt>
            <dd class="font-display font-bold <%= @review.proposal_difference_cents.positive? ? 'text-warning' : 'text-success' %>">
              <%= signed_money(@review.proposal_difference_cents) %>
            </dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t(".answer_before") %></dt>
            <dd><%= l(@review.proposal_expires_at, format: :long) %></dd>
          </div>
        </dl>

        <div class="mt-5 flex flex-wrap gap-3">
          <%= button_to accept_review_proposal_path(@review), class: "btn btn-primary text-sm",
                form: { data: { turbo: false } } do %>
            <%= @review.proposal_difference_cents.positive? ? t(".accept_and_pay") : t(".accept_and_refund") %>
          <% end %>
          <%= button_to t(".decline"), decline_review_proposal_path(@review),
                class: "btn btn-secondary text-sm",
                form: { data: { turbo_confirm: t(".decline_confirm") } } %>
        </div>

        <%# Not paying the difference does not have to mean giving up — once
            per review, the client may try someone else instead. %>
        <% if @review.may_pick_new_designer? %>
          <div class="mt-6 border-t border-line pt-5">
            <p class="label-rule"><%= t(".pick_another") %></p>
            <p class="mt-1 text-sm text-muted"><%= t(".pick_another_hint") %></p>

            <% candidates = @review.reassignment_candidates.limit(8) %>
            <% if candidates.any? %>
              <div class="mt-3 space-y-2">
                <% candidates.each do |profile| %>
                  <%= button_to pick_review_designer_path(@review),
                        params: { designer_profile_id: profile.id },
                        class: "btn btn-secondary flex w-full items-center justify-between text-sm sm:w-auto sm:min-w-72" do %>
                    <span><%= profile.display_name %></span>
                    <span class="font-normal text-muted"><%= rating_summary(profile) %></span>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <p class="mt-3 text-sm text-muted"><%= t(".pick_another_empty") %></p>
            <% end %>
          </div>
        <% end %>

        <p class="mt-3 text-sm text-muted">
          <%= link_to t(".rework_design"), design_path(@review.design),
                class: "underline underline-offset-4" %>
        </p>
      </section>
    <% end %>

    <%# The chosen designer went quiet. Three ways out, and the client picks. %>
    <% if @review.chosen_designer_silent? %>
      <section class="panel border-l-2 border-l-warning p-6">
        <p class="label-rule text-warning"><%= t(".designer_silent") %></p>
        <p class="mt-2 text-muted">
          <%= t(".designer_silent_body", designer: @review.designer_profile.display_name,
                hours: Rails.application.config.tshirt.reviews[:designer_claim_timeout_hours]) %>
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <%= button_to t(".reopen"), reopen_review_path(@review), class: "btn btn-primary text-sm" %>
          <%= button_to t(".cancel_and_refund"), decline_review_proposal_path(@review),
                class: "btn btn-secondary text-sm",
                form: { data: { turbo_confirm: t(".decline_confirm") } } %>
        </div>
      </section>
    <% end %>

    <section>
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
        <h2 class="font-display text-xl font-bold uppercase"><%= t(".versions") %></h2>
        <%= review_status_pill(@review) %>
      </div>
      <div class="mt-4"><%= render "reviews/versions", versions: @versions %></div>

      <%# What the client does with the last version. %>
      <% if @review.delivered? %>
        <div class="panel mt-4 p-5">
          <p class="label-rule"><%= t(".your_turn") %></p>
          <p class="mt-2 text-sm text-muted">
            <%= t(".your_turn_body", days: Rails.application.config.tshirt.reviews[:auto_accept_days]) %>
          </p>

          <div class="mt-4 flex flex-wrap gap-3">
            <%= button_to t(".accept"), accept_review_path(@review), class: "btn btn-primary text-sm" %>
          </div>

          <% if @review.revisions_left? %>
            <%= form_with url: revision_review_path(@review), class: "mt-5 border-t border-line pt-4" do %>
              <%# Explicit id: the conversation below has a `body` field too. %>
              <%= label_tag :revision_body, t(".revision_label"), class: "label-rule block" %>
              <%= text_area_tag :body, nil, rows: 3, required: true, id: "revision_body",
                    placeholder: t(".revision_placeholder"),
                    class: "mt-2 block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
              <button type="submit" class="btn btn-secondary mt-3 text-sm">
                <%= t(".request_revision") %>
              </button>
              <p class="mt-2 text-sm text-muted">
                <%= t(".revisions_left", count: @review.revisions_left) %>
              </p>
            <% end %>
          <% else %>
            <p class="mt-4 border-t border-line pt-4 text-sm text-muted">
              <%= t(".no_revision_left") %>
            </p>
          <% end %>

          <%# Decided on 08/10/2026: when the delivery does not do what was
              asked, the client says so instead of waiting for the week to run
              out. Once per review; the designer is paid only once it is
              settled. %>
          <% if policy(@review).dispute? %>
            <details class="mt-5 border-t border-line pt-4">
              <summary class="cursor-pointer text-sm font-medium text-warning"><%= t(".dispute_open") %></summary>
              <%= form_with url: dispute_review_path(@review), class: "mt-3 space-y-3" do %>
                <p class="text-sm text-muted"><%= t(".dispute_hint") %></p>
                <fieldset class="space-y-2">
                  <legend class="label-rule"><%= t(".dispute_reason") %></legend>
                  <% Review::DISPUTE_REASONS.each_with_index do |reason, index| %>
                    <label class="flex min-h-touch cursor-pointer items-center gap-3 rounded-xs border border-line px-3
                                  has-[:checked]:border-emulsion has-[:checked]:bg-emulsion/5">
                      <%= radio_button_tag :reason, reason, index.zero?, class: "size-4 flex-none" %>
                      <span class="text-sm"><%= t("enums.review.dispute_reason.#{reason}") %></span>
                    </label>
                  <% end %>
                </fieldset>
                <%= label_tag :dispute_message, t(".dispute_message"), class: "label-rule block" %>
                <%= text_area_tag :dispute_message, nil, rows: 3, required: true, minlength: 10, id: "dispute_message",
                      placeholder: t(".dispute_placeholder"),
                      class: "block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
                <button type="submit" class="btn btn-secondary text-sm"><%= t(".dispute_submit") %></button>
              <% end %>
            </details>
          <% end %>
        </div>
      <% end %>

      <% if @review.disputed? %>
        <div class="panel mt-4 border-l-2 border-l-warning p-5">
          <p class="label-rule text-warning"><%= t(".disputed") %></p>
          <p class="mt-2 text-sm text-muted"><%= t(".disputed_body") %></p>

          <% if @review.fix_offered? %>
            <p class="mt-4 border-t border-line pt-4 font-medium"><%= t(".fix_offered") %></p>
            <p class="mt-1 text-sm text-muted"><%= t(".fix_offered_body") %></p>
          <% end %>

          <div class="mt-4 flex flex-wrap gap-3">
            <% if policy(@review).accept_fix? %>
              <%= button_to t(".accept_fix"), accept_fix_review_path(@review), class: "btn btn-primary text-sm" %>
            <% end %>
            <%= button_to t(".accept"), accept_review_path(@review), class: "btn btn-secondary text-sm" %>
            <%= button_to t(".withdraw_dispute"), withdraw_dispute_review_path(@review), class: "btn btn-secondary text-sm" %>
          </div>
        </div>
      <% end %>

      <%# The reworked file, made a design: the way to the workshop. %>
      <% if @reviewed_design %>
        <div class="panel mt-4 border-l-2 border-l-success p-5">
          <p class="label-rule text-success"><%= t(".reviewed_design") %></p>
          <p class="mt-2 text-sm text-muted"><%= t(".reviewed_design_hint") %></p>
          <%= link_to t(".reviewed_design_action"), design_path(@reviewed_design), class: "btn btn-primary mt-4 text-sm" %>
        </div>
      <% end %>

      <%# Rated once, after it is settled. %>
      <% if @review.accepted? && @review.rating.nil? %>
        <div class="panel mt-4 p-5">
          <p class="label-rule"><%= t(".rate") %></p>
          <%= form_with url: rate_review_path(@review), class: "mt-3" do %>
            <div class="flex flex-wrap gap-2">
              <% (1..5).each do |score| %>
                <label class="cursor-pointer rounded-xs border border-line px-4 py-2 text-sm
                              has-[:checked]:border-emulsion has-[:checked]:bg-emulsion/5">
                  <%= radio_button_tag :rating, score, false, class: "sr-only" %>
                  <%= score %>
                </label>
              <% end %>
            </div>
            <%= text_area_tag :comment, nil, rows: 2, placeholder: t(".rate_placeholder"),
                  class: "mt-3 block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
            <button type="submit" class="btn btn-secondary mt-3 text-sm"><%= t(".send_rating") %></button>
          <% end %>
        </div>
      <% end %>
    </section>

    <% if @review.open? %>
      <%= render "reviews/messages", messages: @messages, post_to: review_messages_path(@review) %>
    <% elsif @messages.any? %>
      <%= render "reviews/messages", messages: @messages %>
    <% end %>
  </div>

  <aside class="space-y-6">
    <div class="panel overflow-hidden">
      <div class="screen-tint p-4">
        <%= image_tag design_image_path(@review.design), alt: @review.design.prompt,
              class: "mx-auto w-full max-w-64" %>
      </div>
      <div class="border-t border-line p-4">
        <dl class="space-y-2.5 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t(".level") %></dt>
            <dd class="font-medium"><%= @review.review_level.name %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t(".paid") %></dt>
            <dd class="font-medium"><%= t("reviews.price_ttc", amount: money(@review.price_cents)) %></dd>
          </div>
          <% if @review.refunded_cents.positive? %>
            <div class="flex justify-between gap-4">
              <dt class="text-muted"><%= t(".refunded") %></dt>
              <dd class="font-medium text-success"><%= money(@review.refunded_cents) %></dd>
            </div>
          <% end %>
          <% if @review.designer_profile %>
            <div class="flex justify-between gap-4">
              <dt class="text-muted"><%= t(".designer") %></dt>
              <dd class="text-right">
                <%= link_to @review.designer_profile.display_name,
                      designer_path(@review.designer_profile),
                      class: "underline underline-offset-4" %>
              </dd>
            </div>
          <% end %>
          <% if @review.due_at && @review.in_progress? %>
            <div class="flex justify-between gap-4">
              <dt class="text-muted"><%= t(".due") %></dt>
              <dd><%= l(@review.due_at, format: :long) %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>

    <% if @review.client_brief.present? %>
      <div class="panel p-5">
        <p class="label-rule"><%= t(".your_brief") %></p>
        <p class="mt-2 whitespace-pre-line text-sm"><%= @review.client_brief %></p>
      </div>
    <% end %>
  </aside>
</div>
