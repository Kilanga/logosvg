<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading") %>

<div class="grid max-w-5xl gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-start">
  <%# Decided on 09/10/2026: no designer able to take it, nothing to pay for. %>
  <% if @levels.empty? %>
    <div class="panel border-l-2 border-l-warning p-6">
      <h2 class="font-display text-xl font-bold uppercase"><%= t(".none_available.title") %></h2>
      <p class="mt-3 text-muted"><%= t(".none_available.body") %></p>
      <%= link_to t(".none_available.back"), design_path(@design), class: "btn btn-secondary mt-5 text-sm" %>
    </div>
  <% else %>
  <%= form_with model: @review, url: design_reviews_path(@design), class: "space-y-10",
                data: { turbo: false } do |form| %>
    <% if @review.errors.any? %>
      <div class="border-l-2 border-warning bg-warning-bg px-4 py-3">
        <p class="font-semibold text-warning">
          <%= t("errors.template.header", count: @review.errors.count) %>
        </p>
        <% if @review.errors[:base].any? %>
          <p class="mt-1 text-sm text-warning"><%= @review.errors[:base].to_sentence %></p>
        <% end %>
      </div>
    <% end %>

    <%# 01 — What they are buying. The level decides the price, the deadline
        and how many goes are included, so it leads. %>
    <fieldset>
      <div class="flex items-baseline gap-4 border-b border-line pb-3">
        <span class="font-display text-xl font-bold text-emulsion">01</span>
        <legend class="font-display text-xl font-bold uppercase"><%= t(".level") %></legend>
      </div>

      <div class="mt-4 space-y-2">
        <% @levels.each_with_index do |level, index| %>
          <label class="flex cursor-pointer gap-3 rounded-xs border border-line p-4
                        has-[:checked]:border-emulsion has-[:checked]:bg-emulsion/5">
            <%= form.radio_button :review_level_id, level.id,
                  checked: index.zero?,
                  class: "mt-0.5 size-4 flex-none border-line text-emulsion" %>
            <span class="min-w-0 flex-1">
              <span class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-display text-base font-bold uppercase tracking-[0.04em]">
                  <%= level.name %>
                </span>
                <span class="font-display font-bold text-emulsion"><%= level_price(level, ttc: true) %></span>
              </span>
              <span class="mt-1 block text-sm text-muted"><%= level.description %></span>
              <span class="label-rule mt-1.5 block text-muted"><%= level_terms(level) %></span>
            </span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <%# 02 — Who does it. "First available" is the default because it is the
        fastest; picking someone is the exception, and it can wait. %>
    <fieldset>
      <div class="flex items-baseline gap-4 border-b border-line pb-3">
        <span class="font-display text-xl font-bold text-emulsion">02</span>
        <legend class="font-display text-xl font-bold uppercase"><%= t(".who") %></legend>
      </div>
      <p class="mt-3 text-sm text-muted"><%= t(".who_hint", hours: Rails.application.config.tshirt.reviews[:designer_claim_timeout_hours]) %></p>

      <div class="mt-4 space-y-2">
        <label class="flex min-h-touch cursor-pointer items-center gap-3 rounded-xs border border-line px-3
                      has-[:checked]:border-emulsion has-[:checked]:bg-emulsion/5">
          <%= form.radio_button :designer_profile_id, "", checked: @recommended_designer_id.nil?,
                class: "size-4 border-line text-emulsion" %>
          <span class="text-sm font-medium"><%= t(".first_available") %></span>
        </label>

        <% @designers.each do |profile| %>
          <% recommended = profile.id == @recommended_designer_id %>
          <label class="flex min-h-touch cursor-pointer flex-wrap items-center gap-3 rounded-xs border border-line px-3 py-2
                        has-[:checked]:border-emulsion has-[:checked]:bg-emulsion/5">
            <%= form.radio_button :designer_profile_id, profile.id, checked: recommended,
                  class: "size-4 flex-none border-line text-emulsion" %>
            <span class="min-w-0 flex-1 text-sm">
              <span class="font-medium"><%= profile.display_name %></span>
              <span class="text-muted"> · <%= rating_summary(profile) %></span>
            </span>
            <% if recommended %>
              <span class="pill pill-success"><%= t(".recommended") %></span>
            <% end %>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset>
      <div class="flex items-baseline gap-4 border-b border-line pb-3">
        <span class="font-display text-xl font-bold text-emulsion">03</span>
        <legend class="font-display text-xl font-bold uppercase"><%= t(".brief") %></legend>
      </div>

      <%# Decided on 08/10/2026: the brief in four points rather than one box.
          The designer ticks each point on delivery, so whether the work does
          what was asked can be read, not argued. Only the first is required. %>
      <p class="mt-4 text-sm text-muted"><%= t(".brief_hint") %></p>
      <%= form.fields_for :brief, brief_fields(@review) do |brief| %>
        <% Review::BRIEF_KEYS.each do |key| %>
          <div class="mt-4">
            <%= brief.label key, t("reviews.brief.#{key}"), class: "label-rule block" %>
            <% if key == "change" %>
              <%= brief.text_area key, rows: 3, maxlength: 1000, required: true,
                    placeholder: t(".brief_placeholders.#{key}"),
                    class: "mt-2 block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
            <% else %>
              <%= brief.text_field key, maxlength: 1000,
                    placeholder: t(".brief_placeholders.#{key}"),
                    class: "mt-2 block min-h-touch w-full rounded-xs border border-line bg-surface px-3" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
      <% if @review.errors[:brief].any? %>
        <p class="mt-2 text-sm text-warning"><%= @review.errors[:brief].first %></p>
      <% end %>
    </fieldset>

    <div class="border-t border-line pt-8">
      <% if shop_name %>
        <p class="mb-4 border-l-2 border-line bg-surface px-4 py-3 text-sm text-muted">
          <%= t(".shop_copy", name: shop_name) %>
        </p>
      <% end %>
      <%= form.submit t(".submit"), class: "btn btn-primary w-full sm:w-auto" %>
      <p class="mt-3 text-sm text-muted"><%= t(".payment_hint") %></p>
    </div>
  <% end %>
  <% end %>

  <aside class="space-y-6 lg:sticky lg:top-8">
    <div class="panel overflow-hidden">
      <div class="screen-tint p-4">
        <%= image_tag design_image_path(@design), alt: @design.prompt,
              class: "mx-auto w-full max-w-64" %>
      </div>
      <div class="border-t border-line p-4">
        <h2 class="label-rule"><%= t(".the_design") %></h2>
        <p class="mt-2 text-sm"><%= @design.prompt.truncate(80) %></p>
        <p class="mt-1 text-sm text-muted">
          <%= @design.technique_label %>
          <% if @design.vector? && @design.inks_count %>
            · <%= t("client.designs.design.screens", count: @design.inks_count) %>
          <% end %>
        </p>
      </div>
    </div>

    <div class="panel p-5">
      <p class="label-rule flex items-center gap-2.5 text-emulsion">
        <%= registration_mark %><%= t(".what_you_get") %>
      </p>
      <p class="mt-3 text-sm text-muted"><%= t(".what_you_get_body") %></p>
    </div>
  </aside>
</div>
