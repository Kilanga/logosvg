<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading", printer: @print_request.printer.name) %>

<div class="grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-start">
  <div class="space-y-6">
    <div class="panel p-6">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="label-rule"><%= t(".reference", reference: print_request_reference(@print_request)) %></p>
        <%= print_request_status_pill(@print_request) %>
      </div>

      <% timeline = print_request_timeline(@print_request) %>
      <% if timeline.any? %>
        <%# A rail rather than a word: the client wants to know where the job
            has got to, not to read a noun. %>
        <ol class="mt-6 grid gap-x-3 gap-y-2" style="grid-template-columns: repeat(<%= timeline.size %>, minmax(0, 1fr))">
          <% timeline.each do |step| %>
            <li class="contents">
              <div class="col-span-1">
                <div class="h-1 rounded-xs <%= step[:reached] ? 'bg-emulsion' : 'bg-line' %>"></div>
                <p class="label-rule mt-2 <%= step[:current] ? 'text-emulsion' : 'text-muted' %>">
                  <%= step[:label] %>
                </p>
              </div>
            </li>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-4 text-muted"><%= t("print_requests.status_body.#{@print_request.status}") %></p>
      <% end %>

      <% if @print_request.expired? %>
        <%= link_to t(".choose_another"), printers_path(techniques: [ @print_request.design.technique ]),
              class: "btn btn-primary mt-6" %>
      <% end %>
    </div>

    <div class="panel p-6">
      <h2 class="label-rule"><%= t(".what_was_ordered") %></h2>
      <dl class="mt-4 space-y-3 text-sm">
        <% PrintRequestSheet.call(print_request: @print_request).each do |line| %>
          <div class="flex justify-between gap-6 border-b border-line pb-2 last:border-0">
            <dt class="text-muted"><%= line.label %></dt>
            <dd class="text-right font-medium"><%= line.value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <% if @print_request.may_cancel? %>
      <div class="panel p-6">
        <p class="label-rule"><%= t(".cancel_title") %></p>
        <p class="mt-2 text-sm text-muted"><%= t(".cancel_body") %></p>
        <%= button_to t(".cancel"), cancel_print_request_path(@print_request),
              class: "btn btn-secondary mt-4 text-sm",
              form: { data: { turbo_confirm: t(".cancel_confirm") } } %>
      </div>
    <% end %>
  </div>

  <aside class="space-y-6">
    <div class="panel overflow-hidden">
      <div class="screen-tint p-4">
        <%= image_tag design_image_path(@print_request.design), alt: @print_request.design.prompt,
              class: "mx-auto w-full max-w-64" %>
      </div>
      <div class="border-t border-line p-4">
        <p class="label-rule"><%= t(".workshop") %></p>
        <p class="mt-1.5">
          <%= link_to @print_request.printer.name, printer_path(@print_request.printer),
                class: "font-medium underline underline-offset-4" %>
        </p>
        <p class="mt-1 text-sm text-muted"><%= @print_request.printer.city %></p>
      </div>
    </div>

    <div class="panel p-5">
      <p class="label-rule flex items-center gap-2.5 text-emulsion">
        <%= registration_mark %><%= t(".quote_title") %>
      </p>
      <p class="mt-3 text-sm text-muted"><%= t(".quote_body") %></p>
    </div>
  </aside>
</div>
