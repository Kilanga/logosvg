<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading") %>

<div class="max-w-3xl">
  <%# The shop in context, kept for the whole session by /a/:slug. It is what
      narrows the techniques on offer, so it leads. %>
  <% if context_printer %>
    <div class="panel mb-8 flex flex-wrap items-center justify-between gap-4 p-4">
      <p class="flex items-center gap-3 text-sm">
        <%= registration_mark css_class: "text-emulsion" %>
        <span><%= t(".for_workshop_html", name: tag.strong(context_printer.name)) %></span>
      </p>
      <%= link_to t(".change_workshop"), printers_path,
            class: "text-sm underline underline-offset-4 hover:text-emulsion" %>
    </div>
  <% end %>

  <%# For the client who already has a finished picture — drawn elsewhere, by
      another AI or by hand — and only wants it in the workshop's format. %>
  <%= link_to new_design_upload_path,
        class: "panel mb-10 flex flex-wrap items-center justify-between gap-4 p-4 hover:border-emulsion" do %>
    <span>
      <span class="block font-display text-base font-bold uppercase tracking-[0.04em]"><%= t(".upload_title") %></span>
      <span class="mt-1 block text-sm text-muted"><%= t(".upload_hint") %></span>
    </span>
    <span class="btn btn-secondary text-sm"><%= t(".upload_link") %></span>
  <% end %>

  <%= form_with model: @design, url: designs_path, class: "space-y-10",
        data: {
          controller: "design-form",
          design_form_families_value: available_techniques.to_h { |e| [ e.key, e.family ] }.to_json,
          design_form_ceilings_value: available_techniques.to_h { |e| [ e.key, e.max_colors ] }.to_json
        } do |form| %>

    <%= render "client/designs/technique_fields", form: form %>

    <fieldset>
      <div class="flex items-baseline gap-4 border-b border-line pb-3">
        <span class="font-display text-xl font-bold text-emulsion">02</span>
        <legend class="font-display text-xl font-bold uppercase"><%= t(".idea_legend") %></legend>
      </div>

      <div class="mt-6 space-y-5">
        <div>
          <%= form.label :prompt, t("activerecord.attributes.design.prompt"), class: "label-rule block" %>
          <%= form.text_area :prompt, rows: 3, required: true, maxlength: 300,
                placeholder: t(".prompt_placeholder"),
                class: "mt-2 block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
          <p class="mt-1.5 text-sm text-muted"><%= t(".prompt_hint") %></p>
        </div>

        <%# Optional: the client's own sketch, old logo or photo to start from.
            The rights question is asked only for an image actually sent. %>
        <div class="rounded-xs border border-dashed border-line p-4">
          <%= form.label :reference_image, t(".reference_image"), class: "label-rule block" %>
          <p class="mt-1.5 text-sm text-muted"><%= t(".reference_image_hint") %></p>
          <%= form.file_field :reference_image, accept: ReferenceImage::ACCEPTED.join(","),
                class: "mt-3 block w-full text-sm file:mr-3 file:rounded-xs file:border file:border-line
                       file:bg-surface file:px-3 file:py-2" %>
          <label class="mt-3 flex items-start gap-2.5 text-sm">
            <%= form.check_box :reference_rights_confirmed, class: "mt-0.5 size-4 flex-none border-line text-emulsion" %>
            <span><%= t(".reference_rights") %></span>
          </label>
          <% if @design.errors[:reference_rights_confirmed].any? %>
            <p class="mt-1.5 text-sm text-warning"><%= @design.errors.full_messages_for(:reference_rights_confirmed).first %></p>
          <% end %>
        </div>

        <div>
          <%= form.label :style, t("activerecord.attributes.design.style"), class: "label-rule block" %>
          <div class="mt-2 flex flex-wrap gap-2">
            <% Design::STYLES.each do |style| %>
              <label class="cursor-pointer rounded-xs border border-line px-3 py-2 text-sm
                            has-[:checked]:border-emulsion has-[:checked]:bg-emulsion/5">
                <%= form.radio_button :style, style, class: "sr-only" %>
                <%= t("enums.design.style.#{style}") %>
              </label>
            <% end %>
          </div>
        </div>

        <%= render "client/designs/inks_field", form: form %>

      </div>
    </fieldset>

    <%= render "client/designs/size_fields", form: form, number: "03" %>

    <%= render "shared/turnstile" %>

    <div class="border-t border-line pt-8">
      <%= form.submit t(".submit"), class: "btn btn-primary w-full sm:w-auto" %>
      <%# The counter sits under the button, where the decision is made. %>
      <p class="mt-3 text-sm text-muted">
        <%= t(".remaining", count: GenerationQuota.for(Current.user).remaining) %>
      </p>
    </div>
  <% end %>
</div>
