<%# The design panel, in whichever of its three states it is. Replaced whole
    rather than patched: generating, ready and failed look nothing alike. %>
<div class="panel overflow-hidden">
  <% if design.in_progress? %>
    <div class="screen-tint flex aspect-square w-full flex-col items-center justify-center gap-4 p-8 text-center">
      <span class="flex gap-4 text-emulsion" aria-hidden="true">
        <%= registration_mark %><%= registration_mark %><%= registration_mark %>
      </span>
      <p class="label-rule text-emulsion" role="status"><%= t("client.designs.design.working") %></p>
      <p class="max-w-xs text-sm text-muted"><%= t("client.designs.design.working_hint") %></p>
    </div>

  <% elsif design.failed? %>
    <div class="flex aspect-square w-full flex-col items-center justify-center gap-4 bg-warning-bg p-8 text-center">
      <p class="label-rule text-warning"><%= t("client.designs.design.failed") %></p>
      <p class="max-w-sm text-warning"><%= design.error_message %></p>
      <%# A failed generation consumed no allowance: trying again is free. %>
      <%= link_to t("client.designs.design.try_again"), new_design_path, class: "btn btn-primary mt-2" %>
    </div>

  <% else %>
    <div class="screen-tint p-4">
      <%= image_tag design_image_path(design), alt: design.prompt, class: "mx-auto w-full max-w-lg" %>
    </div>

    <div class="border-t border-line p-4">
      <%# Vector output is counted in screens; raster output in pixels. Asking a
          DTF file how many screens it needs would be meaningless. %>
      <% if design.vector? %>
        <p class="label-rule"><%= t("client.designs.design.screens", count: design.inks_count.to_i) %></p>
        <ul class="mt-3 flex flex-wrap gap-4">
          <% design.palette.each do |ink| %>
            <li class="flex items-center gap-2">
              <span class="size-6 rounded-xs border border-ink/15" style="background-color: <%= ink["hex"] %>"></span>
              <span class="font-display text-sm font-semibold uppercase"><%= ink["hex"] %></span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="label-rule"><%= t("client.designs.design.print_file") %></p>
        <dl class="mt-3 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
          <% design_file_facts(design).each do |label, value| %>
            <div>
              <dt class="label-rule"><%= label %></dt>
              <dd class="mt-0.5 font-semibold"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>

      <% if design.warnings.any? %>
        <ul class="mt-4 space-y-2 border-t border-line pt-4">
          <% design.warnings.each do |warning| %>
            <li class="flex gap-3 border-l-2 border-warning bg-warning-bg px-3 py-2 text-sm text-warning">
              <%= registration_mark css_class: "mt-0.5 flex-none" %><%= warning %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-3 border-t border-line p-4">
      <%# The print file never leaves for the client: this is a watermarked
          rendering of it. %>
      <%= link_to t("client.designs.design.download"), design_image_path(design),
            class: "btn btn-secondary text-sm" %>

      <% if design.refinements_left.to_i.positive? %>
        <%= button_to t("client.designs.design.variants"), design_variants_path(design),
              class: "btn btn-secondary text-sm" %>
      <% end %>
    </div>

    <%# The chat the spec asks for: "que voulez-vous changer ?", the request and
        the new version reading as a conversation. The route, the controller and
        the microservice were all there; this form was the missing piece, so the
        client could only ask for other versions. See docs/SPEC.md,
        "Reprise d'un design". %>
    <% if design.refinements_left.to_i.positive? %>
      <div class="border-t border-line p-4">
        <%# Explicit id: this partial is rendered once per design on the index. %>
        <% champ = "instruction_#{design.token}" %>
        <%= label_tag champ, t("client.designs.design.refine_title"), class: "label-rule block" %>
        <p class="mt-2 text-sm text-muted"><%= t("client.designs.design.refine_hint") %></p>
        <%= form_with url: design_refine_path(design), class: "mt-3" do %>
          <%= text_area_tag :instruction, nil, rows: 2, required: true, maxlength: 300, id: champ,
                placeholder: t("client.designs.design.refine_placeholder"),
                class: "block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
          <button type="submit" class="btn btn-secondary mt-3 text-sm">
            <%= t("client.designs.design.refine_submit") %>
          </button>
        <% end %>
        <p class="mt-2 text-sm text-muted"><%= t("client.designs.design.refine_cost") %></p>
      </div>
    <% end %>

    <%# Budget spent. The two ways of reworking it yourself give way to the
        one that is left: a designer, and it is paid for. See docs/SPEC.md,
        "Reprise d'un design". %>
    <% if design.refinements_left&.zero? %>
      <div class="border-t border-line bg-emulsion/5 p-4">
        <p class="label-rule flex items-center gap-2.5 text-emulsion">
          <%= registration_mark %><%= t("client.designs.design.budget_spent") %>
        </p>
        <p class="mt-2 text-sm text-muted"><%= t("client.designs.design.budget_spent_body") %></p>
        <%= link_to t("client.designs.design.ask_designer"), new_design_review_path(design),
              class: "btn btn-primary mt-4 text-sm" %>
      </div>
    <% elsif design.refinements_left %>
      <p class="border-t border-line px-4 py-3 text-sm text-muted">
        <%= t("client.designs.design.refinements_left", count: design.refinements_left) %>
      </p>
    <% end %>
  <% end %>
</div>
