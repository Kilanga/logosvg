<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading", level: @review.review_level.name) %>

<div class="grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-start">
  <div class="space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line pb-3">
      <%= review_status_pill(@review) %>
      <%= due_badge(@review) %>
    </div>

    <% if @review.client_brief.present? %>
      <section class="panel p-5">
        <h2 class="label-rule"><%= t(".brief") %></h2>
        <p class="mt-2 whitespace-pre-line"><%= @review.client_brief %></p>
      </section>
    <% end %>

    <%# Taking it on. One button, and only when it is actually takeable. %>
    <% if @review.claimable_by?(current_designer_profile) %>
      <section class="panel border-l-2 border-l-emulsion p-6">
        <p class="label-rule text-emulsion"><%= t(".available") %></p>
        <p class="mt-2 text-muted"><%= t(".available_body", hours: @review.review_level.turnaround_hours) %></p>
        <%= button_to t(".claim"), claim_designer_review_path(@review),
              class: "btn btn-primary mt-4" %>
      </section>
    <% end %>

    <section>
      <h2 class="font-display text-xl font-bold uppercase border-b border-line pb-3">
        <%= t(".versions") %>
      </h2>
      <div class="mt-4"><%= render "reviews/versions", versions: @versions %></div>

      <%# Handing one back. The file has to be the kind the design is, and the
          screen says which before anything is chosen. %>
      <% if @review.may_deliver? %>
        <div class="panel mt-4 p-5">
          <p class="label-rule"><%= t(".deliver") %></p>
          <p class="mt-2 text-sm text-muted">
            <%= t(".deliver_hint.#{@review.design.vector? ? 'vector' : 'raster'}",
                  width: @review.design.print_width_cm) %>
          </p>

          <%# `multipart` said out loud: form_with only infers it from a form
              builder's file_field, and a plain file_field_tag leaves the form
              urlencoded — the file then never leaves the browser. %>
          <%= form_with url: deliver_designer_review_path(@review), multipart: true,
                class: "mt-4 space-y-4" do %>
            <div>
              <%= label_tag :file, t(".file"), class: "label-rule block" %>
              <%= file_field_tag :file, required: true,
                    accept: @review.design.vector? ? "image/svg+xml" : "image/png",
                    class: "mt-2 block w-full text-sm" %>
            </div>
            <div>
              <%# Explicit id: the return form further down has a `message`
                  field too, and two fields sharing a name on one page confuse
                  a browser's autofill as much as a reader. %>
              <%= label_tag :version_message, t(".message"), class: "label-rule block" %>
              <%= text_area_tag :message, nil, rows: 3, id: "version_message",
                    placeholder: t(".message_placeholder"),
                    class: "mt-2 block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
            </div>
            <button type="submit" class="btn btn-primary text-sm"><%= t(".send_version") %></button>
          <% end %>
        </div>
      <% end %>
    </section>

    <%# Handing the job back. Once per review, never after a delivery, and the
        work done is not billed. %>
    <% if @review.may_return_to_client? %>
      <section class="panel p-5" data-controller="review-return">
        <p class="label-rule"><%= t(".return_title") %></p>
        <p class="mt-2 text-sm text-muted"><%= t(".return_body") %></p>

        <%= form_with url: return_designer_review_path(@review), class: "mt-4 space-y-4" do %>
          <fieldset>
            <legend class="label-rule"><%= t(".reason") %></legend>
            <div class="mt-2 space-y-1">
              <% Review::RETURN_REASONS.each do |reason| %>
                <label class="flex min-h-touch cursor-pointer items-start gap-2.5 text-sm">
                  <%= radio_button_tag :reason, reason, false, required: true,
                        class: "mt-3 size-4 flex-none border-line text-emulsion",
                        data: { review_return_target: "reason",
                                proposes: Review::PROPOSING_REASONS.include?(reason),
                                action: "review-return#sync" } %>
                  <span class="py-2">
                    <span class="block font-medium"><%= t("enums.review.return_reason.#{reason}") %></span>
                    <span class="block text-muted"><%= t("enums.review.return_hint.#{reason}") %></span>
                  </span>
                </label>
              <% end %>
            </div>
          </fieldset>

          <%# Only for the two reasons that carry a proposal. %>
          <div data-review-return-target="proposal" hidden class="space-y-4 border-l-2 border-line pl-4">
            <div>
              <%= label_tag :proposed_level_id, t(".proposed_level"), class: "label-rule block" %>
              <%= select_tag :proposed_level_id,
                    options_from_collection_for_select(ReviewLevel.offered, :id, :name),
                    include_blank: true,
                    class: "mt-2 block min-h-touch w-full rounded-xs border border-line bg-surface px-3" %>
            </div>
            <div class="max-w-48">
              <%= label_tag :proposed_price, t(".proposed_price"), class: "label-rule block" %>
              <%= number_field_tag :proposed_price, nil, min: 1, step: 1,
                    class: "mt-2 block min-h-touch w-full rounded-xs border border-line bg-surface px-3" %>
              <p class="mt-1.5 text-sm text-muted"><%= t(".proposed_price_hint") %></p>
            </div>
          </div>

          <div>
            <%= label_tag :return_message, t(".return_message"), class: "label-rule block" %>
            <%= text_area_tag :message, nil, rows: 3, required: true, id: "return_message",
                  placeholder: t(".return_message_placeholder"),
                  class: "mt-2 block w-full rounded-xs border border-line bg-surface px-3 py-2" %>
          </div>

          <button type="submit" class="btn btn-secondary text-sm"
                  data-turbo-confirm="<%= t('.return_confirm') %>">
            <%= t(".return_action") %>
          </button>
        <% end %>
      </section>
    <% end %>

    <% if @review.open? %>
      <%= render "reviews/messages", messages: @messages,
            post_to: designer_review_messages_path(@review) %>
    <% elsif @messages.any? %>
      <%= render "reviews/messages", messages: @messages %>
    <% end %>
  </div>

  <aside class="space-y-6">
    <div class="panel overflow-hidden">
      <div class="screen-tint p-4">
        <%= image_tag design_image_path(@review.design), alt: @review.design.prompt,
              class: "mx-auto w-full" %>
      </div>
      <div class="border-t border-line p-4">
        <h2 class="label-rule"><%= t(".the_design") %></h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t("activerecord.attributes.design.technique") %></dt>
            <dd class="font-medium"><%= @review.design.technique_label %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-muted"><%= t("activerecord.attributes.design.print_width_cm") %></dt>
            <dd><%= @review.design.print_width_cm %> cm</dd>
          </div>
          <% if @review.design.vector? && @review.design.inks_count %>
            <div class="flex justify-between gap-4">
              <dt class="text-muted"><%= t("print_requests.sheet.inks") %></dt>
              <dd><%= @review.design.inks_count %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>

    <div class="panel p-5">
      <p class="label-rule"><%= t(".what_you_earn") %></p>
      <p class="mt-2 font-display text-3xl font-bold text-emulsion">
        <%= money(@review.designer_share_cents) %>
      </p>
      <p class="mt-2 text-sm text-muted">
        <%= t(".earn_hint", price: money(@review.price_cents), fee: money(@review.platform_fee_cents)) %>
      </p>
    </div>

    <% if @review.design.warnings.any? %>
      <div class="panel p-5">
        <p class="label-rule"><%= t(".generator_warnings") %></p>
        <ul class="mt-3 space-y-2">
          <% @review.design.warnings.each do |warning| %>
            <li class="flex gap-2.5 border-l-2 border-warning bg-warning-bg px-3 py-2 text-sm text-warning">
              <%= registration_mark css_class: "mt-0.5 flex-none" %><%= warning %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </aside>
</div>
