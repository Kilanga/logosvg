<%# One step towards being able to take work. Done or not is drawn, not written:
    a filled registration mark against an empty one. %>
<li class="flex gap-4">
  <span class="flex size-8 flex-none items-center justify-center rounded-xs border
               <%= done ? 'border-success bg-success-bg text-success' : 'border-line text-muted' %>">
    <% if done %>
      <%= registration_mark %>
    <% else %>
      <span class="font-display text-sm font-bold"><%= number %></span>
    <% end %>
  </span>

  <div class="min-w-0 flex-1">
    <p class="font-medium <%= "text-muted line-through decoration-line" if done %>">
      <%= title %>
    </p>
    <p class="mt-0.5 text-sm text-muted"><%= body %></p>

    <% if path && !done %>
      <%= link_to action, path, class: "mt-2 inline-block text-sm font-medium text-emulsion underline underline-offset-4" %>
    <% end %>
  </div>
</li>
