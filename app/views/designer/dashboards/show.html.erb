<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading", name: Current.user.first_name) %>

<div class="max-w-3xl space-y-8">
  <%# Two gates stand between a designer and work, and they are independent:
      the administration's review, and Stripe's. Both are shown as steps,
      because a designer who has passed one wants to know which is left. %>
  <section class="panel p-6">
    <h2 class="font-display text-xl font-bold uppercase border-b border-line pb-3">
      <%= t(".before_you_start") %>
    </h2>

    <ol class="mt-5 space-y-4">
      <%= render "designer/dashboards/step", number: "01",
            done: @profile.present?,
            title: t(".step.profile.title"),
            body: t(".step.profile.body"),
            action: t(".step.profile.action"),
            path: edit_designer_profile_path %>

      <%= render "designer/dashboards/step", number: "02",
            done: @profile&.payouts_enabled?,
            title: t(".step.payouts.title"),
            body: t(".step.payouts.body"),
            action: t(".step.payouts.action"),
            path: designer_payouts_path %>

      <%# Not a step the designer can act on: it is somebody else's decision,
          so it carries no button. %>
      <%= render "designer/dashboards/step", number: "03",
            done: @profile&.active?,
            title: t(".step.review.title"),
            body: t(".step.review.body"),
            action: nil, path: nil %>
    </ol>

    <% if @profile&.can_take_work? %>
      <p class="mt-6 flex items-center gap-3 border-t border-line pt-5">
        <span class="text-success" aria-hidden="true"><%= registration_mark %></span>
        <span class="font-medium"><%= t(".ready") %></span>
      </p>
    <% elsif @profile %>
      <p class="mt-6 border-t border-line pt-5 text-muted">
        <%= t("designers.unavailable.#{@profile.unavailable_reason}") %>
      </p>
    <% end %>
  </section>

  <%# The queue arrives at step 8. Saying so beats an empty panel. %>
  <section class="panel p-6">
    <h2 class="label-rule"><%= t(".queue") %></h2>
    <p class="mt-3 text-muted"><%= t(".queue_body") %></p>
  </section>
</div>
