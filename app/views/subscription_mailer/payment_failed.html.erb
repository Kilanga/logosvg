<div style="font-family:Helvetica,Arial,sans-serif;color:#1D2433;max-width:600px;">
  <p style="font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:#6B4200;margin:0 0 8px;">
    <%= t("mailers.subscription.payment_failed.eyebrow") %>
  </p>

  <h1 style="font-size:24px;margin:0 0 16px;">
    <%= t("mailers.subscription.payment_failed.heading") %>
  </h1>

  <p style="margin:0 0 24px;line-height:1.5;">
    <%= t("mailers.subscription.payment_failed.body", printer: @printer.name) %>
  </p>

  <%# The date is the useful part: the listing is still up until then. %>
  <% if @hidden_from %>
    <p style="margin:0 0 24px;line-height:1.5;border-left:2px solid #6B4200;background:#FFF3DC;padding:12px 16px;">
      <%= t("mailers.subscription.payment_failed.hidden_from", date: l(@hidden_from.to_date, format: :long)) %>
    </p>
  <% end %>

  <p style="margin:0 0 32px;">
    <a href="<%= workshop_subscription_url %>"
       style="display:inline-block;background:#1F5F7A;color:#FFFFFF;padding:14px 24px;
              text-decoration:none;font-weight:600;border-radius:2px;">
      <%= t("mailers.subscription.payment_failed.action") %>
    </a>
  </p>

  <p style="margin:0;padding-top:16px;border-top:1px solid #C8D0D4;line-height:1.5;color:#505A67;">
    <%= t("mailers.subscription.payment_failed.requests_kept") %>
  </p>
</div>
