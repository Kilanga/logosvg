<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading") %>

<div class="max-w-4xl space-y-8">
  <% if @subscription&.visible? %>
    <%# Subscribed. What matters now is the plan, the renewal date, and one
        door to Stripe for everything else. %>
    <div class="panel p-6">
      <div class="flex flex-wrap items-start justify-between gap-4 border-b border-line pb-4">
        <div>
          <p class="label-rule"><%= t(".current_plan") %></p>
          <p class="mt-1 font-display text-2xl font-bold uppercase">
            <%= t("enums.subscription.plan.#{@subscription.plan}") %>
          </p>
        </div>
        <%= subscription_status_pill(@subscription) %>
      </div>

      <dl class="mt-4 space-y-3 text-sm">
        <% if @subscription.current_period_end %>
          <div class="flex justify-between gap-6">
            <dt class="text-muted"><%= t(".renews_on") %></dt>
            <dd class="font-medium"><%= l(@subscription.current_period_end.to_date, format: :long) %></dd>
          </div>
        <% end %>
        <div class="flex justify-between gap-6">
          <dt class="text-muted"><%= t(".listing_visibility") %></dt>
          <dd class="font-medium"><%= t(".visible") %></dd>
        </div>
      </dl>

      <% if @subscription.past_due? %>
        <div class="mt-5 border-l-2 border-warning bg-warning-bg px-4 py-3">
          <p class="font-semibold text-warning"><%= t(".past_due_title") %></p>
          <p class="mt-1 text-sm text-warning">
            <%= t(".past_due_body", date: l(@subscription.hidden_from.to_date, format: :long)) %>
          </p>
        </div>
      <% end %>

      <div class="mt-6 border-t border-line pt-5">
        <%= button_to t(".open_portal"), workshop_subscription_portal_path, class: "btn btn-primary" %>
        <p class="mt-3 text-sm text-muted"><%= t(".portal_hint") %></p>
      </div>
    </div>

  <% else %>
    <%# Not subscribed, or lapsed. The listing is invisible, and saying so
        plainly matters more than the price table below it. %>
    <div class="panel border-l-2 border-l-warning p-6">
      <p class="label-rule text-warning"><%= t(".not_visible") %></p>
      <p class="mt-2 text-muted"><%= t(".not_visible_body") %></p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <% Subscription::PLANS.each do |plan| %>
        <div class="panel flex flex-col p-6">
          <p class="label-rule text-emulsion"><%= t("enums.subscription.plan.#{plan}") %></p>
          <p class="mt-2 font-display text-3xl font-bold"><%= t(".price_tbd") %></p>
          <p class="mt-3 text-sm text-muted"><%= t(".plan_pitch.#{plan}") %></p>

          <ul class="mt-4 flex-1 space-y-2 text-sm">
            <% t(".plan_features.#{plan}").each do |feature| %>
              <li class="flex gap-2.5">
                <%= registration_mark css_class: "mt-1 flex-none text-emulsion" %><%= feature %>
              </li>
            <% end %>
          </ul>

          <%= button_to t(".subscribe"), workshop_subscription_path, params: { plan: plan },
                class: "btn #{plan == 'atelier_plus' ? 'btn-primary' : 'btn-secondary'} mt-6 w-full" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="panel p-5">
    <p class="label-rule flex items-center gap-2.5 text-emulsion">
      <%= registration_mark %><%= t(".billing_title") %>
    </p>
    <p class="mt-3 text-sm text-muted"><%= t(".billing_body") %></p>
  </div>
</div>
