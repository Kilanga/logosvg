<% content_for :title, t("help.workshop.title") %>
<% content_for :heading, t("help.workshop.heading") %>

<div class="max-w-4xl space-y-12">
  <%# The sheet for its clients leads: it is the one thing on this page a shop
      takes away with it. %>
  <section class="panel flex flex-wrap items-center justify-between gap-4 border-l-2 border-l-emulsion p-5" aria-labelledby="sheet-title">
    <div class="min-w-0 flex-1 basis-72">
      <h2 id="sheet-title" class="font-display text-lg font-bold uppercase"><%= t("help.workshop.sheet_title") %></h2>
      <p class="mt-1 text-sm text-muted"><%= t("help.workshop.sheet_body") %></p>
      <p class="mt-2 text-sm text-muted"><%= help_text(t("help.workshop.help_for_clients", url: help_url)) %></p>
    </div>
    <%= link_to t("help.workshop.sheet_cta"), workshop_invites_path, class: "btn btn-primary text-sm" %>
  </section>

  <section aria-labelledby="guide-title">
    <h2 id="guide-title" class="font-display text-2xl font-bold uppercase"><%= help_text(t("help.workshop.guide_title")) %></h2>
    <ol class="mt-6 space-y-8">
      <% t("help.workshop.steps").each_with_index do |step, index| %>
        <li class="grid gap-x-5 sm:grid-cols-[3rem_minmax(0,1fr)]">
          <span class="font-display text-3xl font-bold text-emulsion"><%= format("%02d", index + 1) %></span>
          <div>
            <h3 class="font-display text-lg font-bold uppercase"><%= help_text(step[:title]) %></h3>
            <div class="mt-2 space-y-2">
              <% step[:body].each do |paragraph| %>
                <p><%= help_text(paragraph) %></p>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
  </section>

  <section aria-labelledby="faq-title">
    <h2 id="faq-title" class="mb-6 font-display text-2xl font-bold uppercase"><%= t("help.workshop.faq_title") %></h2>
    <%= render "shared/faq", groups: t("help.workshop.groups"), id_prefix: "faq-atelier" %>
  </section>
</div>
