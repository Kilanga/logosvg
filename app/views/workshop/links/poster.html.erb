<% content_for :title, t(".title", printer: @printer.name) %>

<%# The counter poster. Screen-printing vocabulary, held to two inks so a shop
    can run it off on its own machine if it would rather: ink and paper. %>
<article class="poster panel mx-auto flex aspect-[1/1.414] max-w-[210mm] flex-col p-12 print:aspect-auto print:h-[273mm]">
  <header class="flex items-start justify-between gap-6 border-b-2 border-ink pb-5">
    <div>
      <p class="label-rule text-emulsion"><%= t(".eyebrow") %></p>
      <h1 class="mt-2 font-display text-5xl font-bold uppercase leading-none">
        <%= @printer.name %>
      </h1>
    </div>
    <span class="flex gap-2 pt-2 text-emulsion" aria-hidden="true">
      <%= registration_mark %><%= registration_mark %>
    </span>
  </header>

  <div class="flex flex-1 flex-col justify-center py-8 text-center">
    <p class="font-display text-4xl font-bold uppercase leading-tight">
      <%= t(".headline") %>
    </p>
    <p class="mx-auto mt-5 max-w-md text-lg text-muted"><%= t(".subhead") %></p>

    <div class="mt-10 flex justify-center"><%= raw @qr %></div>

    <p class="label-rule mt-6"><%= t(".scan") %></p>
    <p class="mt-2 font-mono text-sm text-muted">
      <%= workshop_link_url(slug: @printer.slug).sub(%r{\Ahttps?://}, "") %>
    </p>
  </div>

  <%# Three steps, numbered like the sections of the listing form. %>
  <ol class="grid grid-cols-3 gap-6 border-t-2 border-ink pt-6">
    <% %w[ 01 02 03 ].each_with_index do |number, index| %>
      <li>
        <p class="font-display text-2xl font-bold text-emulsion"><%= number %></p>
        <p class="mt-1 text-sm font-medium"><%= t(".steps")[index] %></p>
      </li>
    <% end %>
  </ol>

  <footer class="mt-6 flex items-baseline justify-between gap-4 border-t border-line pt-4">
    <p class="label-rule text-muted"><%= @printer.city %></p>
    <p class="label-rule text-muted"><%= Rails.application.config.tshirt.platform_name %></p>
  </footer>
</article>
