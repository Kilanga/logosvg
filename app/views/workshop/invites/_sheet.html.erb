<%# One numbered sheet: the same two-ink vocabulary as the counter poster, its
    own single-use QR code, and every step. Each starts a printed page. %>
<article class="poster panel mx-auto mb-10 flex max-w-[210mm] flex-col p-10 break-before-page first:break-before-auto print:mb-0 print:h-[273mm] print:p-0">
  <header class="flex items-start justify-between gap-6 border-b-2 border-ink pb-5">
    <div>
      <p class="label-rule text-emulsion"><%= t("help.sheet.eyebrow") %></p>
      <h1 class="mt-2 font-display text-4xl font-bold uppercase leading-none"><%= @printer.name %></h1>
      <p class="mt-3 font-display text-2xl font-bold uppercase"><%= t("help.sheet.headline") %></p>
    </div>
    <div class="flex-none text-center">
      <div aria-hidden="true"><%= raw WorkshopQrCode.svg(workshop_sheet_url(code: invite.code), size: 200) %></div>
      <p class="label-rule mt-2"><%= t("help.sheet.scan") %></p>
      <p class="mt-1 font-mono text-xs text-muted"><%= t("help.sheet.number", number: invite.number) %></p>
    </div>
  </header>

  <ol class="mt-6 grid flex-1 gap-x-8 gap-y-5 sm:grid-cols-2 print:grid-cols-2">
    <% t("help.sheet.steps").each_with_index do |step, index| %>
      <li class="flex gap-4">
        <span class="font-display text-3xl font-bold leading-none text-emulsion"><%= format("%02d", index + 1) %></span>
        <span>
          <span class="block font-display text-base font-bold uppercase tracking-[0.04em]"><%= help_text(step[:title]) %></span>
          <span class="mt-1 block text-sm"><%= help_text(step[:body]) %></span>
        </span>
      </li>
    <% end %>
  </ol>

  <section class="mt-6 border-t-2 border-ink pt-4">
    <h2 class="label-rule"><%= t("help.sheet.tips_title") %></h2>
    <ul class="mt-2 space-y-1 text-sm">
      <% t("help.sheet.tips").each do |tip| %>
        <li><%= I18n.interpolate(tip, help_values.merge(help_url: help_url.sub(%r{\Ahttps?://}, ""))) %></li>
      <% end %>
    </ul>
  </section>

  <footer class="mt-6 flex items-baseline justify-between gap-4 border-t border-line pt-4">
    <p class="label-rule text-muted"><%= @printer.city %></p>
    <p class="label-rule text-muted"><%= Rails.application.config.tshirt.platform_name %></p>
  </footer>
</article>
