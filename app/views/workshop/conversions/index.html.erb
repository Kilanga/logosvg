<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading") %>

<div class="max-w-4xl space-y-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <p class="max-w-2xl text-muted"><%= t(".lead") %></p>
    <%= link_to t(".new"), new_workshop_conversion_path, class: "btn btn-primary" %>
  </div>

  <% if @designs.any? %>
    <ul class="divide-y divide-line border-y border-line">
      <% @designs.each do |design| %>
        <li class="flex flex-wrap items-center gap-4 py-4">
          <span class="min-w-0 flex-1 basis-64">
            <%= link_to design.prompt, workshop_conversion_path(design),
                  class: "block font-medium underline-offset-4 hover:text-emulsion hover:underline" %>
            <span class="mt-0.5 block text-sm text-muted">
              <%= design.technique_label %> · <%= l(design.created_at.to_date, format: :long) %>
            </span>
          </span>
          <%= design_status_pill(design) %>
          <% if policy(design).download_print_file? %>
            <%= link_to t(".download", file_format: design.print_file.blob.filename.extension.upcase),
                  workshop_conversion_file_path(design), class: "btn btn-secondary" %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <p class="text-sm text-muted"><%= t(".retention", days: Rails.application.config.tshirt.privacy[:design_retention_days]) %></p>
  <% else %>
    <div class="panel screen-tint flex flex-col items-center gap-3 p-10 text-center">
      <span class="flex gap-4 text-emulsion" aria-hidden="true"><%= registration_mark %><%= registration_mark %></span>
      <p class="font-display text-xl font-bold uppercase"><%= t(".empty") %></p>
      <p class="max-w-md text-sm text-muted"><%= t(".empty_body") %></p>
    </div>
  <% end %>
</div>
