<% content_for :title, t(".title") %>
<% content_for :heading, t(".heading", name: Current.user.first_name) %>

<div class="max-w-5xl space-y-8">
  <%# The listing is the one thing a printer must do before anything else
      works, so it leads, and it says exactly where it stands. %>
  <section class="panel p-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h2 class="font-display text-xl font-bold uppercase"><%= t(".listing") %></h2>
      <% if @printer %><%= printer_status_pill(@printer) %><% end %>
    </div>

    <p class="mt-3 text-muted"><%= t(".listing_state.#{@printer&.status || 'missing'}") %></p>

    <%# Published but not paid for is the one state that looks fine and is not:
        the listing exists and nobody can see it. %>
    <% if @printer&.published? && !@subscription&.visible? %>
      <div class="mt-4 border-l-2 border-warning bg-warning-bg px-4 py-3">
        <p class="font-semibold text-warning"><%= t(".not_visible") %></p>
        <p class="mt-1 text-sm text-warning"><%= t(".not_visible_body") %></p>
      </div>
    <% end %>

    <div class="mt-5 flex flex-wrap gap-3">
      <%= link_to @printer ? t(".edit_listing") : t(".create_listing"),
            edit_workshop_profile_path, class: "btn btn-primary" %>
      <% if @printer&.persisted? && @subscription&.visible? %>
        <%= link_to t(".view_listing"), printer_path(@printer), class: "btn btn-secondary" %>
      <% end %>
    </div>
  </section>

  <% if @printer&.persisted? %>
    <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-start">
      <section>
        <div class="flex items-baseline justify-between gap-4 border-b border-line pb-3">
          <h2 class="font-display text-xl font-bold uppercase"><%= t(".recent_requests") %></h2>
          <%= link_to t(".see_all"), workshop_print_requests_path,
                class: "text-sm underline underline-offset-4 hover:text-emulsion" %>
        </div>

        <%# The month's figures, in the condensed face: a shop reads numbers
            here, not sentences. %>
        <dl class="mt-4 grid grid-cols-3 gap-4">
          <div class="panel p-4">
            <dt class="label-rule"><%= t(".this_month") %></dt>
            <dd class="mt-1 font-display text-3xl font-bold"><%= @month[:requests] %></dd>
          </div>
          <div class="panel p-4">
            <dt class="label-rule"><%= t(".to_confirm") %></dt>
            <dd class="mt-1 font-display text-3xl font-bold text-emulsion"><%= @month[:to_confirm] %></dd>
          </div>
          <div class="panel p-4">
            <dt class="label-rule"><%= t(".garments") %></dt>
            <dd class="mt-1 font-display text-3xl font-bold"><%= @month[:garments] %></dd>
          </div>
        </dl>

        <% if @print_requests.any? %>
          <ul class="mt-4 space-y-2">
            <% @print_requests.each do |print_request| %>
              <li>
                <%= link_to workshop_print_request_path(print_request),
                      class: "panel flex items-center gap-4 p-3 hover:border-emulsion" do %>
                  <div class="screen-tint size-12 flex-none overflow-hidden rounded-xs">
                    <%= image_tag design_image_path(print_request.design), alt: "",
                          class: "size-full object-contain" %>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="label-rule"><%= print_request_reference(print_request) %></p>
                    <p class="mt-0.5 truncate text-sm"><%= print_request.contact_name %></p>
                  </div>
                  <%= print_request_status_pill(print_request) %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="panel mt-4 p-6 text-center">
            <p class="text-muted"><%= t(".no_request") %></p>
          </div>
        <% end %>
      </section>

      <aside class="space-y-6">
        <%# The link is what brings the work in, so it sits on the dashboard
            rather than only on its own page. %>
        <div class="panel p-5">
          <p class="label-rule"><%= t(".your_link") %></p>
          <div class="mt-3 flex justify-center">
            <%= raw WorkshopQrCode.svg(workshop_link_url(slug: @printer.slug), size: 132) %>
          </div>
          <p class="mt-3 break-all text-center font-mono text-sm text-muted">
            <%= workshop_link_url(slug: @printer.slug).sub(%r{\Ahttps?://}, "") %>
          </p>
          <%= link_to t(".share_link"), workshop_link_share_path,
                class: "btn btn-secondary mt-4 w-full text-sm" %>
        </div>

        <div class="panel p-5">
          <p class="label-rule"><%= t(".subscription") %></p>
          <p class="mt-2 font-medium">
            <%= @subscription ? t("enums.subscription.plan.#{@subscription.plan}") : t(".no_subscription") %>
          </p>
          <% if @subscription %>
            <p class="mt-1"><%= subscription_status_pill(@subscription) %></p>
          <% end %>
          <%= link_to t(".manage_subscription"), workshop_subscription_path,
                class: "btn btn-secondary mt-4 w-full text-sm" %>
        </div>
      </aside>
    </div>
  <% end %>
</div>
